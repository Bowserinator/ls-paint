export enum ETool {
    NONE, SELECTION, RESIZE, ROTATE,
    PENCIL, BRUSH, FILL, SHAPE, TEXT, ERASER, DROPPER, MAGNIFY
}
export enum ESelectionType { RECTANGULAR, FREEHAND, POLYGON }
export enum ERotation { CW90, CCW90, R180 }
export enum EContentTransform { ROTATE_CW90, ROTATE_CCW90, ROTATE_180, FLIP_HORIZONTAL, FLIP_VERTICAL }

// Every shape the Shapes picker offers, in the order it shows them.
export enum EShapeKind {
    LINE, CURVE, OVAL, RECTANGLE, ROUNDED_RECTANGLE, POLYGON,
    TRIANGLE, RIGHT_TRIANGLE, DIAMOND, PENTAGON, HEXAGON,
    ARROW_RIGHT, ARROW_LEFT, ARROW_UP, ARROW_DOWN,
    STAR_4, STAR_5, STAR_6,
    CALLOUT_ROUNDED, CALLOUT_OVAL, CALLOUT_CLOUD,
    HEART, LIGHTNING
}
// How the outline or the fill of a shape is painted.
export enum EShapeTexture {
    NONE,
    SOLID,
    CRAYON,
    MARKER,
    OIL,
    NATURAL_PENCIL,
    WATERCOLOR
}

// The brush types the Brushes picker offers.
export enum EBrushKind {
    BRUSH,
    CALLIGRAPHY_1,
    CALLIGRAPHY_2,
    AIRBRUSH,
    OIL,
    CRAYON,
    MARKER,
    NATURAL_PENCIL,
    WATERCOLOR,
}

// One run of the marching-ants outline, in document pixels. The pattern is
// rebuilt from the C++ side on every animation tick.
export struct SelectionDash {
    x: float,
    y: float,
    w: float,
    h: float,
}

// A resize grip, positioned by the anchor it is centred on (document pixels).
export struct SelectionGrip {
    x: float,
    y: float,
}

export global UserState  {
    callback pointer-down(length, length, bool);
    callback pointer-move(length, length);
    callback pointer-up(length, length);
    callback canvas-resize(length, length);
    callback key-pressed(string, bool, bool);

    callback select-shape(ESelectionType);
    callback select-all();
    callback invert-selection();
    callback clear-selection();
    callback transparent-selection();
    callback crop-to-selection();
    callback rotate(ERotation);
    callback flip-horizontal();
    callback flip-vertical();

    // Clipboard / selection contents (Cut, Copy, Paste and the context menu)
    callback cut-selection();
    callback copy-selection();
    callback paste-selection();
    callback transform-selection-content(EContentTransform);

    // The text box is committed by the editor (Enter, focus loss) and by the
    // C++ side when the user clicks elsewhere or leaves the tool.
    callback commit-text(string);
    // Escape abandons the box: it closes without writing anything.
    callback cancel-text;
    // Raised as the text changes, so the backend can measure what to draw the
    // preview's rules against.
    callback measure-text(text: string);

    // File tab.
    callback file-new();
    callback file-open();
    callback file-save();
    callback file-save-as();
    callback file-exit();
    // TODO: the File menu's recent list. Nothing fills it yet, and nothing
    // reacts to a click on an entry; the index is a position in recent-files.
    in property <[string]> recent-files: [];
    callback file-open-recent(int);

    // View tab "Show or hide" toggles. UI only: nothing reads them yet.
    in-out property <bool> show-rulers: false;
    in-out property <bool> show-gridlines: false;
    in-out property <bool> show-status-bar: true;
    callback paste-from-file();
    callback resize-dialog();
    callback edit-colors();
    callback about();

    in property <[color]> color_palette;
    in-out property <int> color_idx: 0;
    in-out property <color> primary-color: black;
    in-out property <color> secondary-color: white;

    in-out property <ETool> selected-tool: PENCIL;
    in-out property <ESelectionType> selection-type: RECTANGULAR;

    // View zoom in screen pixels per document pixel. Ctrl+wheel changes it,
    // and every screen-to-document coordinate conversion divides by it.
    in-out property <float> zoom: 1.0;

    // Pointer position in document pixels, kept by the canvas itself while
    // the cursor is over the paper; the status bar blanks the readout over
    // the gray around it, where cursor-on-canvas is false.
    in-out property <bool> cursor-on-canvas: false;
    in-out property <float> cursor-x;
    in-out property <float> cursor-y;

    // The paper colour under the pointer as "(r,g,b) #rrggbb", published by the
    // view; blank while the pointer is off the paper.
    in-out property <string> hover-color-text: "";
}

// The zoom ladder the status bar walks: 25% steps below 100, 100% steps
// above, from 12.5% to 700%. Positions are slider units, one per notch.
// pct-to-pos maps a zoom percentage onto the slider track and pos-to-pct
// reads one back; whole numbers land exactly on notches either way, so
// 100% sits at position 4 rather than in the middle.
export global ZoomScale {
    public pure function pct-to-pos(pct: float) -> float {
        if (pct <= 25.0) {
            return (pct - 12.5) / 12.5;
        } else if (pct <= 50.0) {
            return 1.0 + (pct - 25.0) / 25.0;
        } else if (pct <= 75.0) {
            return 2.0 + (pct - 50.0) / 25.0;
        } else if (pct <= 100.0) {
            return 3.0 + (pct - 75.0) / 25.0;
        } else if (pct <= 200.0) {
            return 4.0 + (pct - 100.0) / 100.0;
        } else if (pct <= 300.0) {
            return 5.0 + (pct - 200.0) / 100.0;
        } else if (pct <= 400.0) {
            return 6.0 + (pct - 300.0) / 100.0;
        } else if (pct <= 500.0) {
            return 7.0 + (pct - 400.0) / 100.0;
        } else if (pct <= 600.0) {
            return 8.0 + (pct - 500.0) / 100.0;
        } else {
            return 9.0 + (pct - 600.0) / 100.0;
        }
    }

    public pure function pos-to-pct(pos: float) -> float {
        if (pos <= 1.0) {
            return 12.5 + pos * 12.5;
        } else if (pos <= 2.0) {
            return 25.0 + (pos - 1.0) * 25.0;
        } else if (pos <= 3.0) {
            return 50.0 + (pos - 2.0) * 25.0;
        } else if (pos <= 4.0) {
            return 75.0 + (pos - 3.0) * 25.0;
        } else if (pos <= 5.0) {
            return 100.0 + (pos - 4.0) * 100.0;
        } else if (pos <= 6.0) {
            return 200.0 + (pos - 5.0) * 100.0;
        } else if (pos <= 7.0) {
            return 300.0 + (pos - 6.0) * 100.0;
        } else if (pos <= 8.0) {
            return 400.0 + (pos - 7.0) * 100.0;
        } else if (pos <= 9.0) {
            return 500.0 + (pos - 8.0) * 100.0;
        } else {
            return 600.0 + (pos - 9.0) * 100.0;
        }
    }
}

export global DocumentState {
    // The document's name and whether it has been touched since it was saved.
    in property <string> title: "untitled";
    in property <bool> modified: false;
    in property <int> canvas-width;
    in property <int> canvas-height;
    in property <bool> has-selection;
    in property <bool> has-clipboard;
    in property <int> selection-x;
    in property <int> selection-y;
    in property <int> selection-width;
    in property <int> selection-height;

    // Alternating light and dark runs covering the selection's border; both
    // lists together are the complete outline, and both crawl as the phase
    // advances.
    in property <[SelectionDash]> ants-dark;
    in property <[SelectionDash]> ants-light;

    // Empty unless the selection tool is holding a selection big enough for
    // the grips not to swallow the drag-inside-to-move target.
    in property <[SelectionGrip]> grips;
}

export global ToolOptions {
    in-out property <length> brush-size: 1px;
    // The brush type picks the tip and how tightly the stamps are laid down on
    // the next stroke; the plain brush keeps the settings below.
    in-out property <EBrushKind> brush-kind: BRUSH;
    in-out property <bool> brush-square: false;
    in-out property <float> brush-spacing: 0.25;
}

// Shape tool settings, set by the Shapes, Outline and Fill ribbon dropdowns.
export global ShapeStyle {
    in-out property <EShapeKind> kind: RECTANGLE;
    in-out property <EShapeTexture> outline: SOLID;
    in-out property <EShapeTexture> fill: NONE;
    in-out property <int> thickness: 2;
}

// One entry of the Shapes picker palette. The commands come from the same
// geometry the rasterizer uses, so a glyph always shows what the tool draws.
export struct ShapeGlyph {
    commands: string,
    kind: EShapeKind,
    // Open kinds (line, curve) have no interior to fill.
    filled: bool,
}
export global ShapeGallery {
    in property <[ShapeGlyph]> items;
}

// One entry of the Brushes picker, in the order the picker shows them.
export struct BrushGlyph {
    kind: EBrushKind,
    image: image,
}
export global BrushGallery {
    in property <[BrushGlyph]> items: [
        { kind: EBrushKind.BRUSH, image: @image-url("../icons/brushes/brush.png") },
        { kind: EBrushKind.CALLIGRAPHY_1, image: @image-url("../icons/brushes/calligraphy-1.png") },
        { kind: EBrushKind.CALLIGRAPHY_2, image: @image-url("../icons/brushes/calligraphy-2.png") },
        { kind: EBrushKind.AIRBRUSH, image: @image-url("../icons/brushes/airbrush.png") },
        { kind: EBrushKind.OIL, image: @image-url("../icons/brushes/oil.png") },
        { kind: EBrushKind.CRAYON, image: @image-url("../icons/brushes/crayon.png") },
        { kind: EBrushKind.MARKER, image: @image-url("../icons/brushes/marker.png") },
        { kind: EBrushKind.NATURAL_PENCIL, image: @image-url("../icons/brushes/natural-pencil.png") },
        { kind: EBrushKind.WATERCOLOR, image: @image-url("../icons/brushes/watercolor.png") },
    ];
}

// The shape being dragged, as an outline the view draws over the paper. The
// commands are document-space path data, so the raster commit and the preview
// share one geometry.
export global ShapeOverlay {
    in-out property <bool> visible: false;
    in-out property <string> commands: "";
    in-out property <bool> draw-fill: false;
    in-out property <bool> draw-outline: true;
    // The preview carries the same two colors the commit rasterizes with.
    in-out property <color> outline-color: black;
    in-out property <color> fill-color: white;
}

// Text tool settings, set by the font controls in the Text tab.
export global FontStyle {
    in-out property <string> family: "DejaVu Sans";
    in-out property <length> size: 16px;
    in-out property <bool> bold: false;
    in-out property <bool> italic: false;
    in-out property <bool> underline: false;
    in-out property <bool> strike: false;
    // An opaque background fills the band behind each line with the secondary
    // color when the block is committed.
    in-out property <bool> opaque-background: false;
    // Every family the text tool can draw with. The backend publishes the list,
    // because only it knows which fonts the platform has.
    in property <[string]> families: [];
    // Narrows the family list to the names that contain the query, ignoring case.
    callback filter-families(query: string);
    // The factor the overlay's font size is scaled by so that the editing preview
    // is as large as the committed pixels. The backend republishes it when the
    // family changes, because only it can measure the face.
    in-out property <float> preview-scale: 1.0;
    // Raised when the family changes, so the backend can republish the scale.
    callback family-changed;
}

// The text box being edited. The content is written by the editor, and the
// rest is document-space state the text tool owns.
export global TextOverlay {
    in-out property <bool> visible: false;
    in-out property <length> x: 0px;
    in-out property <length> y: 0px;
    in-out property <color> color: black;
    in-out property <string> content: "";
    // The width of each line in document pixels, published by the backend, so
    // the preview's underline and strikethrough rules stop at the end of their
    // line instead of running to the edge of the box.
    in-out property <[float]> line-widths: [];
}

// Paint's Edit Colors surface. The picker works in HSV: the ring picks the hue
// and the square inside it the saturation and the value. C++ keeps the color,
// the color the square shades and the readouts in step with those three.
// Which question a file dialog is asking.
export enum EFileDialogMode { OPEN, SAVE, PASTE }

// The modal surfaces the window can raise: the file picker, the question about
// unsaved changes, and plain messages. Only one is visible at a time.
export global DialogState {
    // Unsaved changes: Save / Don't Save / Cancel.
    in-out property <bool> confirm-visible: false;
    in-out property <string> confirm-message: "";

    in-out property <bool> message-visible: false;
    in-out property <string> message-title: "";
    in-out property <string> message-text: "";

    in-out property <bool> file-visible: false;
    in-out property <EFileDialogMode> file-mode: OPEN;
    in-out property <string> file-title: "Open";
    in-out property <string> file-accept-text: "Open";
    in-out property <string> file-path: "";
    in-out property <string> file-directory: "";
    // One label per row of the listing, plus the path each label stands for.
    in-out property <[string]> file-labels: [];
    in-out property <[string]> file-paths: [];
    in-out property <int> file-filter: 0;
    in-out property <int> file-format: 0;
    in-out property <bool> file-has-error: false;
    in-out property <string> file-error: "";

    callback file-up();
    callback file-navigate(int);
    callback file-filter-changed(int);
    callback file-ok();
    callback file-cancel();
    callback confirm-save();
    callback confirm-discard();
    callback confirm-cancel();
    callback message-ok();

    // Resize the canvas in pixels. The fields are text so the user can clear
    // them while typing; the entries are checked before anything is resized.
    in-out property <bool> resize-visible: false;
    in-out property <string> resize-width: "800";
    in-out property <string> resize-height: "600";
    callback resize-ok();
    callback resize-cancel();
}
