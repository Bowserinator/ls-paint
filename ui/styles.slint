export global Styles {
    out property<length> bar-font-size: 12px;
    out property<length> bar-padding: 4px;
    out property<length> bar-list-spacing: 2px;
    out property<length> bar-height: 110px;
    out property<length> bar-vertical-btn-width: 54px;

    // Ribbon overflow. A group merges into a single dropdown button once the
    // ribbon is too narrow for the groups up to and including it. The widths
    // below are the natural widths of the fully expanded groups at the default
    // fonts and icon sizes, measured from a 1600px wide window.
    out property<length> ribbon-overflow-margin: 8px;
    out property<length> ribbon-divider: 2px;
    // A merged group measured from outside, and the button inside it. The
    // difference is the group's own padding.
    out property<length> ribbon-merged-width: 64px;
    out property<length> ribbon-merged-button: 56px;
    // One shape glyph cell in the Shapes box.
    out property<length> ribbon-shape-cell: 26px;
    out property<length> ribbon-width-clipboard: 132px;
    out property<length> ribbon-width-image: 206px;
    out property<length> ribbon-width-tools: 164px;
    out property<length> ribbon-width-brushes: 72px;
    out property<length> ribbon-width-shapes: 314px;
    out property<length> ribbon-width-size: 62px;
    out property<length> ribbon-width-colors: 424px;
    out property<length> ribbon-width-about: 84px;

    out property<length> bar-small-icon-size: 20px;
    out property<length> bar-large-icon-size: 38px;

    out property<color> bar-border-light: #dadada;
    out property<color> bar-text-color: #333;

    out property<length> bar-dropdown-width: 192px;
    out property<length> bar-dropdown-height: 28px;
    out property<length> color-btn-spacing: 4px;

    // Height of the strip a tool can show between the ribbon and the paper.
    out property<length> text-options-height: 28px;

    // The tab strip above the ribbon.
    out property<length> tab-height: 24px;
    out property<color> tab-backstage: #1a6fc4;

    // The canvas right click menu: compact, one column, square corners.
    out property<length> menu-width: 168px;
    out property<length> menu-item-height: 22px;
    out property<color> menu-hover: #c9e0f7;
}
