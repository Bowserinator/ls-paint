import { DropdownArrow } from "dropdown-arrow.slint";
import { Styles } from "../styles.slint";

component ImageButtonBase inherits Rectangle {
    in-out property<bool> focused: false;
    in-out property<bool> force_hover: false;
    in-out property<bool> enabled: true;

    in-out property<image> icon: @image-url("../../icons/paste.png");
    in-out property<length> font-size: Styles.bar-font-size;

    out property is-hovered <=> touch.has-hover;
    out property is-pressed <=> touch.pressed;

    callback clicked <=> touch.clicked;

    opacity: enabled ? 1.0 : 0.4;
    border-radius: 0;
    border-width: 1px;
    border-color: focused ? #8dbcec : touch.pressed ? #a0c6ed : (force_hover || touch.has-hover) ? #bedbf8 : transparent;
    background: focused ? Styles.menu-hover : touch.pressed ? #d5e6f7 : transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
        enabled: root.enabled;
    }
}


// Utils
// +--------------------------------+
component PaddedLayoutV inherits VerticalLayout {
    padding: Styles.bar-padding;
    padding-left: Styles.bar-padding * 2;
    padding-right: Styles.bar-padding * 2;
    spacing: Styles.bar-padding / 2;
    alignment: start;
}

component PaddedLayoutH inherits HorizontalLayout {
    padding: Styles.bar-padding / 2;
    padding-left: Styles.bar-padding * 2;
    padding-right: Styles.bar-padding * 2;
    alignment: center;
}

component ButtonText inherits Text {
    color: Styles.bar-text-color;
    // A caption stays on one line: a squeezed button shortens it instead of
    // stacking its letters.
    wrap: no-wrap;
    overflow: elide;
    horizontal-alignment: center;
    // A caption shares its row with an icon, so it is centred against it rather
    // than sitting at the top of its line box.
    vertical-alignment: center;
}


// Buttons
// +--------------------------------+

// The big icon a ribbon button leads with, optionally in a light box: a group's
// icon reads as a tile once the group sheds the buttons around it.
component LargeIcon inherits Rectangle {
    in property <image> icon;
    in property <bool> boxed: false;

    width: Styles.bar-large-icon-size;
    height: Styles.bar-large-icon-size;

    Image {
        width: 100%;
        height: 100%;
        source: root.icon;
    }
    if root.boxed : Rectangle {
        background: transparent;
        border-width: 1px;
        border-color: Styles.ribbon-icon-border-color;
    }
}

// An icon with text below
export component ImageButtonVertical inherits ImageButtonBase {
    in-out property text <=> txt.text;
    in-out property <bool> boxed-icon: false;

    width: Styles.bar-vertical-btn-width;

    PaddedLayoutV {
        HorizontalLayout {
            alignment: center;

            LargeIcon {
                icon: root.icon;
                boxed: root.boxed-icon;
            }
        }
        txt := ButtonText { font-size: root.font-size; }
    }
}

// A colored rectangle with text below
export component ColorButtonVertical inherits ImageButtonBase {
    in-out property text <=> txt.text;
    in-out property<color> colr;

    width: Styles.bar-vertical-btn-width;

    PaddedLayoutV {
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: Styles.bar-large-icon-size;
                height: Styles.bar-large-icon-size;
                border-width: 1px;
                border-color: Styles.ribbon-icon-border-color;

                Rectangle {
                    x: 2px;
                    y: 2px;
                    width: parent.width - 4px;
                    height: parent.height - 4px;
                    background: colr;
                }
            }
        }
        txt := ButtonText { font-size: root.font-size; }
    }
}

// An icon with text below that functions as a dropdown
export component ImageButtonVerticalDropdown {
    in-out property focused1 <=> btn1.focused;
    in-out property focused2 <=> btn2.focused;

    in-out property<string> text;
    in-out property<image> icon: @image-url("../../icons/paste.png");
    in-out property<length> font-size: Styles.bar-font-size;
    in-out property <bool> boxed-icon: false;

    out property<bool> any-hovered: btn1.is-hovered || btn2.is-hovered;

    callback clicked <=> btn1.clicked;
    callback clicked_dropdown <=> btn2.clicked;

    width: Styles.bar-vertical-btn-width;

    VerticalLayout {
        alignment: start;
        spacing: -1px;

        btn1 := ImageButtonBase {
            force_hover: any-hovered;

            PaddedLayoutH {
                LargeIcon {
                    icon: root.icon;
                    boxed: root.boxed-icon;
                }
            }
        }

        btn2 := ImageButtonBase {
            force_hover: any-hovered;

            PaddedLayoutV {
                txt := ButtonText {
                    text: root.text;
                    font-size: root.font-size;
                    // A caption longer than the button shortens instead of
                    // pushing past the button's edge. The layout keeps
                    // Styles.bar-padding * 2 on each side.
                    max-width: root.width - 4 * Styles.bar-padding;
                }
                HorizontalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    DropdownArrow { }
                }
            }
        }
    }
}

// A small icon with text to the right
export component ImageButtonHorizontal inherits ImageButtonBase {
    in-out property text <=> txt.text;
    // The color the icon is drawn against. Transparent shows the icon's own
    // artwork only.
    in-out property <color> swatch: transparent;

    HorizontalLayout {
        padding: Styles.bar-padding;
        padding-top: Styles.bar-padding / 2;
        padding-bottom: Styles.bar-padding / 2;
        spacing: Styles.bar-padding;
        alignment: start;

        VerticalLayout {
            Rectangle {
                width: Styles.bar-small-icon-size;
                height: Styles.bar-small-icon-size;
                background: root.swatch;

                Image {
                    width: 100%;
                    height: 100%;
                    source: root.icon;
                }
            }
        }

        txt := ButtonText { font-size: root.font-size; }
    }
}

export component ImageButtonHorizontalDropdown inherits ImageButtonBase {
    in-out property text <=> txt.text;
    // The arrow's own box, so the panel a button opens can sit under it.
    out property <length> arrow-x: arrow.x;
    out property <length> arrow-y: arrow.y;
    out property <length> arrow-width: arrow.width;
    out property <length> arrow-height: arrow.height;

    HorizontalLayout {
        padding: Styles.bar-padding;
        padding-top: Styles.bar-padding / 2;
        padding-bottom: Styles.bar-padding / 2;
        spacing: Styles.bar-padding;
        alignment: start;

        VerticalLayout {
            Image {
                width: Styles.bar-small-icon-size;
                height: Styles.bar-small-icon-size;
                source: root.icon;
            }
        }

        txt := ButtonText {
            font-size: root.font-size;
            horizontal-stretch: 1;
            horizontal-alignment: start;
        }

        arrow := Rectangle {
            width: 6.3px;

            DropdownArrow {
                y: (parent.height - self.height) / 2;
            }
        }
    }
}

// A text-only ribbon button, for the File tab where no icon exists.
export component BarButton inherits ImageButtonBase {
    in-out property text <=> txt.text;

    HorizontalLayout {
        padding: Styles.bar-padding;
        padding-top: Styles.bar-padding / 2;
        padding-bottom: Styles.bar-padding / 2;
        alignment: center;

        txt := ButtonText { font-size: root.font-size; }
    }
}

// Just a small icon button
export component ImageButtonIcon inherits ImageButtonBase {
    width: Styles.bar-small-icon-size + 2 * Styles.bar-padding;
    height: Styles.bar-small-icon-size + 2 * Styles.bar-padding;

    Image {
        width: Styles.bar-small-icon-size;
        height: Styles.bar-small-icon-size;
        source: root.icon;
    }
}

// Color icon
export component ColorButton inherits ImageButtonBase {
    in-out property <color> colr;
    // One cell of the palette grid the button sits in.
    in property <length> cell: Styles.bar-small-icon-size + Styles.bar-padding;

    width: root.cell;
    height: root.cell;
    border-width: 1px;
    border-color: root.is-pressed ? #a0c6ed : root.is-hovered ? #bedbf8 : Styles.bar-border-light;

    Rectangle {
        width: root.cell - Styles.bar-padding;
        height: root.cell - Styles.bar-padding;
        background: colr;
    }
}
