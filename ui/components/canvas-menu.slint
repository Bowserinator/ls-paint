import { Styles } from "../styles.slint";

// One command line of the canvas right click menu: its icon, a thin rule, and
// the caption.
export component CanvasMenuItem inherits Rectangle {
    in property <string> caption;
    in property <image> icon;
    in property <bool> enabled: true;
    callback activated;

    height: Styles.menu-item-height;
    width: Styles.menu-width;
    background: touch.has-hover && enabled ? Styles.menu-hover : transparent;
    opacity: enabled ? 1.0 : 0.4;

    Image {
        x: (Styles.menu-item-height - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        source: root.icon;
        image-fit: contain;
    }

    Rectangle {
        x: Styles.menu-item-height;
        width: 1px;
        height: parent.height;
        background: Styles.bar-border-light;
    }

    Text {
        x: Styles.menu-item-height + 1px + Styles.bar-padding;
        width: parent.width - self.x - Styles.bar-padding;
        height: parent.height;
        text: root.caption;
        font-size: Styles.bar-font-size;
        color: Styles.bar-text-color;
        vertical-alignment: center;
        wrap: no-wrap;
        overflow: elide;
    }

    touch := TouchArea {
        clicked => {
            if (root.enabled) {
                root.activated();
            }
        }
    }
}

// A divider between groups of entries.
export component CanvasMenuDivider inherits Rectangle {
    width: Styles.menu-width;
    height: 1px;
    background: Styles.bar-border-light;
}

// The frame the entries sit in: white, square, one pixel border.
export component CanvasMenuFrame inherits Rectangle {
    width: Styles.menu-width + 2px;
    background: white;
    border-width: 1px;
    border-color: Styles.bar-border-light;
}
