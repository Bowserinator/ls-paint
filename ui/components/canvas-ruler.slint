import { DocumentState, UserState } from "../globals.slint";
import { Styles } from "../styles.slint";

// A ruler number, put together from a sheet of digits: this renderer moves
// items but does not turn them, so the left strip's number is drawn from a
// sheet whose cells are already turned. The two sheets share one cell size, so
// a turned cell is as wide as an upright one is tall.
component RulerNumber inherits Rectangle {
    in property <float> value: 0.0;
    in property <bool> turned: false;
    // One cell of digits.png. ruler/generate.sh writes these two figures out
    // when it draws the sheets, and they change with the digit size.
    private property <int> cell-width: 8;
    private property <int> cell-height: 9;

    width: root.turned ? root.cell-height * 1px : 4 * root.cell-width * 1px;
    height: root.turned ? 4 * root.cell-width * 1px : root.cell-height * 1px;

    for k in 4 : Image {
        source: root.turned ? @image-url("../../icons/ruler/digits-turned.png")
            : @image-url("../../icons/ruler/digits.png");
        colorize: Styles.ruler-label-color;
        // The sheet holds the digits in order, so the cell a digit needs is its
        // own value times the cell size: the digit is the place it stands for,
        // less the next place up times ten.
        source-clip-x: round(floor(root.value / pow(10, 3 - k))
            - 10 * floor(root.value / pow(10, 4 - k)))
            * (root.turned ? root.cell-height : root.cell-width);
        source-clip-y: 0;
        source-clip-width: root.turned ? root.cell-height : root.cell-width;
        source-clip-height: root.turned ? root.cell-width : root.cell-height;
        width: (root.turned ? root.cell-height : root.cell-width) * 1px;
        height: (root.turned ? root.cell-width : root.cell-height) * 1px;
        x: root.turned ? (root.width - self.width) / 2 : k * root.cell-width * 1px;
        y: root.turned ? k * root.cell-width * 1px : 0px;
        // The digits read from the largest place down, and a leading zero is
        // left out.
        visible: k == 3 || root.value >= pow(10, 3 - k);
    }
}

// A ruler along one edge of the canvas view: a tick at every document step,
// longer ticks with their coordinate on the steps that are numbered, and marks
// for the pointer and the selection. Both strips are this component, told which
// way they lie, and they sit beside the view rather than over it.
export component CanvasRuler inherits Rectangle {
    // The strip down the left edge: its ticks run downwards and its numbers are
    // turned to read along it.
    in property <bool> vertical: false;
    // The document size along the strip, how long the view is, and where it is
    // scrolled to: the tick for document step n stands at zoom * n plus the
    // scroll offset.
    in property <length> doc-length: 0px;
    in property <length> view-length: 0px;
    in property <length> scroll-offset: 0px;
    // How far the strip's start sits past the document's zero: the top strip
    // starts above the left strip, not at the view.
    in property <length> start-in: 0px;
    in property <bool> show-pointer: false;
    // Pointer and selection extent along the strip, in document pixels.
    in property <float> pointer: 0.0;
    in property <bool> show-selection: false;
    in property <float> selection-start: 0.0;
    in property <float> selection-size: 0.0;

    background: Styles.ribbon-background;
    clip: true;

    // The numbered step: a hundred document pixels, which is the scale a ruler
    // is read in. Zoomed far enough out the hundred is widened so two numbers
    // never land on top of each other.
    private property <float> major: UserState.zoom >= 0.4 ? 100.0
        : UserState.zoom >= 0.2 ? 200.0
        : UserState.zoom >= 0.08 ? 500.0
        : 1000.0;
    // Nine smaller ticks divide the hundred.
    private property <float> minor: root.major / 10.0;
    // Numbered ticks run the strip's full depth; the smaller ones only reach
    // part of the way in.
    private property <length> major-length: Styles.ruler-size;
    private property <length> minor-length: 6px;
    // The first step the view shows: only the visible stretch is drawn, so the
    // ruler follows the scroll instead of building a tick per document step.
    private property <float> first-minor:
        max(0.0, floor(-root.scroll-offset / (root.minor * UserState.zoom * 1px)));
    private property <float> first-major:
        max(0.0, floor(-root.scroll-offset / (root.major * UserState.zoom * 1px)));
    // The last step the document has, so no tick reaches past its edge.
    private property <float> last-step: root.doc-length / 1px;

    // The smaller ticks, then the numbered ones over them.
    for j in ceil(root.view-length / (root.minor * UserState.zoom * 1px)) + 2 : Rectangle {
        x: root.vertical
            ? root.width - root.minor-length
            : root.start-in + root.scroll-offset + (root.first-minor + j) * root.minor * UserState.zoom * 1px;
        y: root.vertical
            ? root.start-in + root.scroll-offset + (root.first-minor + j) * root.minor * UserState.zoom * 1px
            : root.height - root.minor-length;
        width: root.vertical ? root.minor-length : 1px;
        height: root.vertical ? 1px : root.minor-length;
        visible: (root.first-minor + j) * root.minor <= root.last-step;
        background: Styles.bar-border-light;
    }

    for j in ceil(root.view-length / (root.major * UserState.zoom * 1px)) + 2 : Rectangle {
        x: root.vertical
            ? root.width - root.major-length
            : root.start-in + root.scroll-offset + (root.first-major + j) * root.major * UserState.zoom * 1px;
        y: root.vertical
            ? root.start-in + root.scroll-offset + (root.first-major + j) * root.major * UserState.zoom * 1px
            : root.height - root.major-length;
        width: root.vertical ? root.major-length : 1px;
        height: root.vertical ? 1px : root.major-length;
        visible: (root.first-major + j) * root.major <= root.last-step;
        background: Styles.bar-text-color;
    }

    // The numbers, one along each strip, each starting just past its own full
    // depth tick: upright along the top one and turned on the left one.
    for j in ceil(root.view-length / (root.major * UserState.zoom * 1px)) + 2 : RulerNumber {
        value: (root.first-major + j) * root.major;
        x: root.start-in + root.scroll-offset + (root.first-major + j) * root.major * UserState.zoom * 1px + 3px;
        y: (root.height - self.height) / 2;
        visible: !root.vertical && (root.first-major + j) * root.major <= root.last-step;
    }

    for j in ceil(root.view-length / (root.major * UserState.zoom * 1px)) + 2 : RulerNumber {
        turned: true;
        value: (root.first-major + j) * root.major;
        x: (root.width - self.width) / 2;
        y: root.start-in + root.scroll-offset + (root.first-major + j) * root.major * UserState.zoom * 1px + 3px;
        visible: root.vertical && (root.first-major + j) * root.major <= root.last-step;
    }

    // The pointer, right across the strip, and the extent of the selection
    // along the edge the ticks are on.
    Rectangle {
        visible: root.show-pointer;
        x: root.vertical
            ? 0px
            : root.start-in + root.scroll-offset + root.pointer * UserState.zoom * 1px;
        y: root.vertical
            ? root.start-in + root.scroll-offset + root.pointer * UserState.zoom * 1px
            : 0px;
        width: root.vertical ? root.width : 1px;
        height: root.vertical ? 1px : root.height;
        background: Styles.ruler-pointer-color;
    }

    Rectangle {
        visible: root.show-selection;
        x: root.vertical
            ? root.width - root.major-length
            : root.start-in + root.scroll-offset + root.selection-start * UserState.zoom * 1px;
        y: root.vertical
            ? root.start-in + root.scroll-offset + root.selection-start * UserState.zoom * 1px
            : root.height - root.major-length;
        width: root.vertical ? root.major-length : root.selection-size * UserState.zoom * 1px;
        height: root.vertical ? root.selection-size * UserState.zoom * 1px : root.major-length;
        background: Styles.menu-hover;
    }
}
