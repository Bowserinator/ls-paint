import { Styles } from "../styles.slint";

export component BarDropdown {
    cache-rendering-hint: true;
    // Wider than the default only for the panels whose contents need it.
    in property <length> panel-width: Styles.bar-dropdown-width + 2phx;

    Rectangle {
        background: white;
        border-width: 1phx;
        border-color: Styles.bar-border-light;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: rgba(0, 0, 0, 0.06);
    }

    VerticalLayout {
        width: root.panel-width;
        padding: 1phx;
        @children
    }
}

export component BarDropdownDivider {
    Rectangle {
        width: Styles.bar-dropdown-width;
        height: 1phx;
        background: Styles.bar-border-light;
    }
}

export component BarDropdownTitle {
    cache-rendering-hint: true;
    in-out property text <=> txt.text;
    // The row is as tall as an ordinary menu row unless the menu is tighter.
    in property <length> title-height: Styles.bar-dropdown-height;

    width: Styles.bar-dropdown-width;
    height: root.title-height;

    Rectangle { background: #f6f7f8; }

    txt := Text {
        font-size: Styles.bar-font-size;
        color: Styles.large-menu-title-color;
        font-weight: 700;
        horizontal-alignment: left;
        x: Styles.bar-padding;
    }
}

export component BarDropdownItem {
    cache-rendering-hint: true;
    callback clicked <=> touch.clicked;
    in-out property text <=> txt.text;
    // The face the label is drawn in, so a list of family names can preview
    // each one. Empty draws in the window's default.
    in property <string> label-family: "";
    in-out property<image> icon;
    // A check item shows a check mark where the icon would be while it is on,
    // and nothing while it is off.
    in property <bool> checkable: false;
    in property <bool> checked: false;
    in-out property <bool> focused;
    in property <bool> enabled: true;

    width: Styles.bar-dropdown-width;
    height: Styles.bar-dropdown-height;

    opacity: enabled ? 1.0 : 0.4;
    Rectangle {
        background: focused ? Styles.menu-hover : touch.has-hover ? #edf4fc : transparent;
        border-width: 1phx;
        border-color: focused ? #8dbcec : touch.has-hover ? #bfdcfb : transparent;
    }

    HorizontalLayout {
        VerticalLayout {
            alignment: space-around;
            width: Styles.bar-dropdown-height;
            padding-left: (Styles.bar-dropdown-height - Styles.bar-small-icon-size) / 2;

            if (!root.checkable) : Image {
                width: Styles.bar-small-icon-size;
                height: Styles.bar-small-icon-size;
                source: root.icon;
            }
            if (root.checkable) : Rectangle {
                width: Styles.bar-small-icon-size;
                height: Styles.bar-small-icon-size;

                if (root.checked) : Path {
                    width: 100%;
                    height: 100%;
                    viewbox-width: 20;
                    viewbox-height: 20;
                    commands: "M 4 10.5 L 8.5 15 L 16 5";
                    stroke: #1a1a1a;
                    stroke-width: 2px;
                }
            }
        }

        Rectangle {
            background: Styles.bar-border-light;
            width: 1phx;
            height: root.height;
        }

        // Spacer
        Rectangle { width: 2 * Styles.bar-padding; }

        txt := Text {
            font-family: root.label-family;
            font-size: Styles.bar-font-size;
            color: Styles.bar-text-color;
            horizontal-alignment: left;
            vertical-alignment: center;
            height: root.height;
        }
    }

    touch := TouchArea { enabled: root.enabled; }
}

// A menu row for menus whose entries are all text: no icon column and no
// divider, so the label starts in the row's own padding.
export component BarDropdownTextItem inherits Rectangle {
    callback clicked <=> touch.clicked;
    in-out property <string> text <=> txt.text;
    // The face the label is drawn in, so a list of family names can preview
    // each one. Empty draws in the window's default.
    in property <string> label-family: "";
    in property <length> label-size: Styles.bar-font-size;
    in-out property <bool> focused: false;

    width: Styles.bar-dropdown-width;
    height: Styles.bar-dropdown-compact-height;

    Rectangle {
        background: focused ? Styles.menu-hover : touch.has-hover ? #edf4fc : transparent;
        border-width: 1phx;
        border-color: focused ? #8dbcec : touch.has-hover ? #bfdcfb : transparent;
    }

    HorizontalLayout {
        Rectangle { width: Styles.bar-padding; } // Spacer

        txt := Text {
            font-family: root.label-family;
            font-size: root.label-size;
            color: Styles.bar-text-color;
            horizontal-alignment: left;
            vertical-alignment: center;
            height: root.height;
        }
    }

    touch := TouchArea {}
}

export component BarSizeDropdownItem {
    callback clicked <=> touch.clicked;

    in-out property<length> size;
    in-out property text <=> txt.text;

    width: Styles.bar-dropdown-width;
    height: Styles.bar-dropdown-height * 1.5;

    Rectangle {
        background: touch.has-hover ? #edf4fc : transparent;
        border-width: 1phx;
        border-color: touch.has-hover ? #bfdcfb : transparent;
    }

    HorizontalLayout {
        Rectangle { width: 2 * Styles.bar-padding; } // Spacer

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: root.width * 0.7;
                // The preview stops growing here: a wider stroke spills out of the row.
                height: min(size, 40px);
                background: black;
            }
        }

        Rectangle { width: 2 * Styles.bar-padding; } // Spacer

        txt := Text {
            font-size: Styles.bar-font-size;
            color: Styles.bar-text-color;
            horizontal-alignment: left;
            vertical-alignment: center;
            height: root.height;
        }
    }

    touch := TouchArea {}
}
