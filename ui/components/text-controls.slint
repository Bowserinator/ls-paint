import { DropdownArrow } from "dropdown-arrow.slint";
import { Styles } from "../styles.slint";

// A plain ribbon button that shows its current value and drops a list of the
// other ones. The Font controls are all of this shape.
export component ValueButton inherits Rectangle {
    cache-rendering-hint: true;
    in property <string> caption;
    // The face the caption is drawn in, so the font control previews the family
    // it currently names. Empty draws in the window's default.
    in property <string> caption-family: "";
    in-out property <bool> focused: false;
    callback clicked;

    height: 22px;
    background: focused ? Styles.menu-hover : touch.has-hover ? #e5f1fb : white;
    border-width: 1phx;
    border-color: focused ? #8dbcec : #c8c8c8;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 4px;
        spacing: 4px;

        Text {
            text: root.caption;
            font-family: root.caption-family;
            font-size: Styles.bar-font-size;
            color: Styles.bar-text-color;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        Rectangle {
            width: 6.3px;

            DropdownArrow {
                y: (parent.height - self.height) / 2;
                arrow-color: #555;
            }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A style toggle: the glyph shows the style it turns on.
export component StyleToggle inherits Rectangle {
    cache-rendering-hint: true;
    in property <string> glyph;
    // The face the glyph is drawn in. Empty draws in the window's default; the
    // italic button names a serif face, as Paint's does.
    in property <string> glyph-family: "";
    in property <bool> active: false;
    in property <bool> bold-glyph: false;
    in property <bool> italic-glyph: false;
    // Draws the rule the glyph stands for: under the letter or through it.
    in property <bool> underline-glyph: false;
    in property <bool> strike-glyph: false;
    callback clicked;

    width: 24px;
    height: 22px;
    background: active ? Styles.menu-hover : touch.has-hover ? #e5f1fb : transparent;
    border-width: 1phx;
    border-color: active ? #8dbcec : transparent;

    Text {
        text: root.glyph;
        font-family: root.glyph-family;
        font-size: 13px;
        font-weight: root.bold-glyph ? 700 : 400;
        font-italic: root.italic-glyph;
        color: Styles.bar-text-color;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Rectangle {
        visible: root.underline-glyph;
        x: (root.width - self.width) / 2;
        y: 15px;
        width: 12px;
        height: 1px;
        background: Styles.bar-text-color;
    }

    Rectangle {
        visible: root.strike-glyph;
        x: (root.width - self.width) / 2;
        y: 10px;
        width: 12px;
        height: 1px;
        background: Styles.bar-text-color;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}
