import { Styles } from "./styles.slint";
import { ETool, UserState } from "./globals.slint";

import { FileMenu } from "./components/file-menu.slint";
import { HomeBar } from "./bar/bar-home.slint";
import { TextBar } from "./bar/bar-text.slint";
import { ViewBar } from "./bar/bar-view.slint";

// One tab of the ribbon strip.
component RibbonTab inherits Rectangle {
    in property <string> title;
    in property <bool> selected;
    // The File tab is a button that opens a menu: it is filled blue and is
    // never the selected page.
    in property <bool> backstage: false;
    // Held open by the File menu while it is up.
    in property <bool> pressed: false;
    // The Text tab: framed by two separators while it is not the one selected.
    in property <bool> contextual: false;
    callback clicked;
    callback double-clicked;

    height: Styles.tab-height;
    background: backstage ? (pressed || touch.has-hover ? Styles.tab-backstage-open : Styles.tab-backstage)
        : selected ? Styles.ribbon-background
        : touch.has-hover ? #f0f1f2
        : Styles.tab-strip-background;

    // The frame of the selected tab, open at the bottom so it runs into the
    // ribbon below it.
    if (root.selected && !root.backstage) : Rectangle {
        border-width: 1px;
        border-color: Styles.tab-border;
    }
    if (root.selected && !root.backstage) : Rectangle {
        x: 1px;
        y: root.height - 1px;
        width: root.width - 2px;
        height: 1px;
        background: Styles.ribbon-background;
    }

    if (root.contextual && !root.selected) : Rectangle {
        x: 0px;
        width: 1px;
        background: Styles.tab-contextual-border;
    }
    if (root.contextual && !root.selected) : Rectangle {
        x: root.width - 1px;
        width: 1px;
        background: Styles.tab-contextual-border;
    }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.title;
        wrap: no-wrap;
        color: root.backstage ? white : Styles.bar-text-color;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: Styles.bar-font-size;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
    }
}

// The button at the end of the tab strip: a chevron pointing up while the ribbon
// is open and down while it is closed.
component RibbonToggle inherits Rectangle {
    in property <bool> open;
    callback clicked;

    background: touch.has-hover ? #f0f1f2 : transparent;

    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 10px;
        height: 6px;
        viewbox-width: 10;
        viewbox-height: 6;
        commands: root.open ? "M 1 5 L 5 1 L 9 5" : "M 1 1 L 5 5 L 9 1";
        fill: transparent;
        stroke: Styles.bar-text-color;
        stroke-width: 1px;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The tab strip and the bar of the selected tab. Nothing here takes part in the
// window's layout: a layout child would pin the window's width to its preferred
// size, and the window has to be freely resizable.
export component TopBar inherits Rectangle {
    // The window opens on Home, as Paint does. The File tab is not a page, so
    // 0 is never selected.
    private property <int> tab: 1;
    // The Text tab is only up while the text tool is, and picking that tool
    // selects it. Leaving the tool falls back to Home.
    private property <bool> text-tool: UserState.selected-tool == ETool.TEXT;
    // The paste commands ask the system clipboard about itself when the page
    // changes, which keeps a shell round trip out of the drawing path.
    changed tab => {
        UserState.check-clipboard();
    }
    // While the ribbon is closed, a tab opens it over the paper until the
    // pointer goes elsewhere. Only its tab reads as selected while it is up.
    private property <bool> ribbon-shown: UserState.show-ribbon || ribbon-popup.is-open;
    // Picking a tool or a command puts the ribbon away again.
    private property <ETool> tool: UserState.selected-tool;
    changed tool => { ribbon-popup.close(); }
    function pick-tab(page: int) {
        root.tab = page;
        if (!UserState.show-ribbon) {
            ribbon-popup.show();
        }
    }
    function toggle-ribbon() {
        ribbon-popup.close();
        UserState.show-ribbon = !UserState.show-ribbon;
    }
    changed text-tool => {
        if (root.text-tool) {
            root.tab = 3;
        } else if (root.tab == 3) {
            root.tab = 1;
        }
    }

    height: Styles.tab-height + (UserState.show-ribbon ? Styles.bar-height : 0px);

    Rectangle {
        y: 0px;
        width: 100%;
        height: Styles.tab-height;
        background: Styles.tab-strip-background;
    }

    // The line under the tab strip, which the selected tab covers.
    Rectangle {
        y: Styles.tab-height - 1px;
        width: 100%;
        height: 1px;
        background: Styles.tab-border;
    }

    if (UserState.show-ribbon && root.tab == 1) : HomeBar {
        y: Styles.tab-height;
        width: 100%;
    }
    if (UserState.show-ribbon && root.tab == 2) : ViewBar {
        y: Styles.tab-height;
        width: 100%;
    }
    if (UserState.show-ribbon && root.tab == 3) : TextBar {
        y: Styles.tab-height;
        width: 100%;
    }

    // Drawn after the bars so the selected tab sits over the line above them.
    HorizontalLayout {
        y: 0px;
        height: Styles.tab-height;
        alignment: start;
        spacing: 0;

        RibbonTab {
            width: Styles.tab-width-file;
            title: "File";
            backstage: true;
            pressed: file-menu.is-open;
            clicked => { file-menu.show(); }
        }
        RibbonTab {
            width: Styles.tab-width-home;
            title: "Home";
            selected: root.ribbon-shown && root.tab == 1;
            clicked => { root.pick-tab(1); }
            double-clicked => { root.toggle-ribbon(); }
        }
        RibbonTab {
            width: Styles.tab-width-view;
            title: "View";
            selected: root.ribbon-shown && root.tab == 2;
            clicked => { root.pick-tab(2); }
            double-clicked => { root.toggle-ribbon(); }
        }
        RibbonTab {
            width: Styles.tab-width-text;
            title: "Text";
            visible: root.text-tool;
            contextual: true;
            selected: root.ribbon-shown && root.tab == 3;
            clicked => { root.pick-tab(3); }
            double-clicked => { root.toggle-ribbon(); }
        }
    }

    RibbonToggle {
        x: parent.width - self.width;
        y: 0px;
        width: Styles.ribbon-toggle-width;
        height: Styles.tab-height - 1px;
        open: UserState.show-ribbon;
        clicked => { root.toggle-ribbon(); }
    }

    ribbon-popup := PopupWindow {
        x: 0px;
        y: Styles.tab-height;
        width: root.width;
        height: Styles.bar-height;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Styles.ribbon-background;

            if (root.tab == 1) : HomeBar {
                width: 100%;
            }
            if (root.tab == 2) : ViewBar {
                width: 100%;
            }
            if (root.tab == 3) : TextBar {
                width: 100%;
            }
        }
    }

    file-menu := PopupWindow {
        x: 0px;
        y: Styles.tab-height;

        FileMenu {}
    }
}
