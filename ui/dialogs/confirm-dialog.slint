import { Win10, WinButton } from "../win10.slint";

// The question asked before throwing work away, laid out like a Windows message
// box: the question in blue on a white panel, the three answers on the gray
// strip below it. A real window, so the window manager draws the title bar and
// its close button.
export component ConfirmDialog inherits Window {
    title: "LS Paint";
    width: 380px;
    height: body.preferred-height + 2 * Win10.frame-width;
    always-on-top: true;
    default-font-family: "WeblySleek UI";

    in property <string> message: "";

    callback accepted();
    callback discarded();
    callback cancelled();

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: Win10.face-color;
        border-width: Win10.frame-width;
        border-color: Win10.frame-color;

        body := VerticalLayout {
            padding: Win10.frame-width;

            Rectangle {
                background: Win10.field-color;
                vertical-stretch: 1;

                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 13px;
                    padding-bottom: 26px;

                    Text {
                        text: root.message;
                        wrap: word-wrap;
                        font-size: Win10.font-size * 1.2;
                        color: Win10.message-color;
                    }
                }
            }

            HorizontalLayout {
                padding: 12px;
                alignment: end;
                spacing: 8px;

                WinButton {
                    text: "Save";
                    is-default: true;
                    clicked => { root.accepted(); }
                }
                WinButton {
                    text: "Don't Save";
                    clicked => { root.discarded(); }
                }
                WinButton {
                    text: "Cancel";
                    clicked => { root.cancelled(); }
                }
            }
        }
    }
}
