import { Button } from "std-widgets.slint";
import { DialogState } from "../globals.slint";
import { Styles } from "../styles.slint";

// The question asked before throwing work away.
export component ConfirmDialog inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #00000040;

    TouchArea {}

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 440px;
        height: 160px;
        background: white;
        border-width: 1px;
        border-color: Styles.bar-border-light;

        VerticalLayout {
            padding: 10px;
            spacing: 8px;

            Text {
                text: DialogState.confirm-message;
                wrap: word-wrap;
                vertical-stretch: 1;
                horizontal-stretch: 1;
                color: Styles.bar-text-color;
            }

            HorizontalLayout {
                alignment: end;
                spacing: 6px;
                horizontal-stretch: 1;

                Button {
                    text: "Save";
                    primary: true;
                    clicked => { DialogState.confirm-save(); }
                }
                Button {
                    text: "Don't Save";
                    clicked => { DialogState.confirm-discard(); }
                }
                Button {
                    text: "Cancel";
                    clicked => { DialogState.confirm-cancel(); }
                }
            }
        }
    }
}
