import { Win10, WinButton } from "../win10.slint";

// The question asked before throwing work away. A real window, so the window
// manager draws the title bar and its close button; the face, the text and the
// three answers wear the Windows 10 colors and controls the other dialogs use.
export component ConfirmDialog inherits Window {
    title: "LS Paint";
    width: 380px;
    height: 96px;
    always-on-top: true;

    in property <string> message: "";

    callback accepted();
    callback discarded();
    callback cancelled();

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: Win10.face-color;
        border-width: Win10.frame-width;
        border-color: Win10.frame-color;

        VerticalLayout {
            padding: 12px;
            spacing: 10px;

            Text {
                text: root.message;
                wrap: word-wrap;
                vertical-stretch: 1;
                horizontal-stretch: 1;
                font-size: Win10.font-size;
                color: Win10.text-color;
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                horizontal-stretch: 1;

                WinButton {
                    text: "Save";
                    is-default: true;
                    clicked => { root.accepted(); }
                }
                WinButton {
                    text: "Don't Save";
                    clicked => { root.discarded(); }
                }
                WinButton {
                    text: "Cancel";
                    clicked => { root.cancelled(); }
                }
            }
        }
    }
}
