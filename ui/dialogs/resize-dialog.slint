import { Win10, WinButton, WinFieldLabel, WinNumberBox } from "../win10.slint";

// Canvas size in pixels. A real window, so the window manager draws the title
// bar and its close button; the face, the fields and the two answers wear the
// Windows 10 colors and controls the other dialogs use. Only the size changes:
// what is already on the paper keeps its place and the new area is filled with
// the secondary color.
export component ResizeDialog inherits Window {
    title: "Resize image";
    width: 340px;
    height: 175px;
    always-on-top: true;

    // The fields are text so the user can clear them while typing; the entries
    // are checked before anything is resized.
    in-out property <string> width-text: "800";
    in-out property <string> height-text: "600";

    callback accepted();
    callback cancelled();

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: Win10.face-color;
        border-width: Win10.frame-width;
        border-color: Win10.frame-color;

        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            HorizontalLayout {
                spacing: 8px;

                WinFieldLabel {
                    text: "Width:";
                    width: 60px;
                }
                WinNumberBox {
                    width: 90px;
                    text <=> root.width-text;
                    accepted => { root.accepted(); }
                }
                Text {
                    text: "px";
                    vertical-alignment: center;
                    font-size: Win10.font-size;
                    color: Win10.text-color;
                }
            }

            HorizontalLayout {
                spacing: 8px;

                WinFieldLabel {
                    text: "Height:";
                    width: 60px;
                }
                WinNumberBox {
                    width: 90px;
                    text <=> root.height-text;
                    accepted => { root.accepted(); }
                }
                Text {
                    text: "px";
                    vertical-alignment: center;
                    font-size: Win10.font-size;
                    color: Win10.text-color;
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                horizontal-stretch: 1;

                WinButton {
                    text: "OK";
                    is-default: true;
                    clicked => { root.accepted(); }
                }
                WinButton {
                    text: "Cancel";
                    clicked => { root.cancelled(); }
                }
            }
        }
    }
}
