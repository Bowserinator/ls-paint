import { Button, LineEdit } from "std-widgets.slint";
import { DialogState } from "../globals.slint";
import { Styles } from "../styles.slint";

// Canvas size in pixels. Only the size changes: what is already on the paper
// keeps its place and the new area is filled with the secondary color.
export component ResizeDialog inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #00000040;

    TouchArea {}

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 320px;
        height: 150px;
        background: white;
        border-width: 1px;
        border-color: Styles.bar-border-light;

        VerticalLayout {
            padding: 10px;
            spacing: 8px;

            Text {
                text: "Resize image";
                color: Styles.bar-text-color;
            }

            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: "Width:";
                    width: 55px;
                    vertical-alignment: center;
                    color: Styles.bar-text-color;
                }
                LineEdit {
                    text <=> DialogState.resize-width;
                    input-type: number;
                    horizontal-stretch: 1;
                }
                Text {
                    text: "px";
                    width: 20px;
                    vertical-alignment: center;
                    color: Styles.bar-text-color;
                }
            }

            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: "Height:";
                    width: 55px;
                    vertical-alignment: center;
                    color: Styles.bar-text-color;
                }
                LineEdit {
                    text <=> DialogState.resize-height;
                    input-type: number;
                    horizontal-stretch: 1;
                }
                Text {
                    text: "px";
                    width: 20px;
                    vertical-alignment: center;
                    color: Styles.bar-text-color;
                }
            }

            HorizontalLayout {
                alignment: end;
                horizontal-stretch: 1;
                spacing: 6px;

                Button {
                    text: "OK";
                    primary: true;
                    clicked => { DialogState.resize-ok(); }
                }
                Button {
                    text: "Cancel";
                    clicked => { DialogState.resize-cancel(); }
                }
            }
        }
    }
}
