import { Win10, WinButton } from "../win10.slint";

// A plain message with one way out. A real window, so the window manager draws
// the title bar and its close button; the face, the text and the button wear the
// Windows 10 colors and controls the other dialogs use. The heading is the
// window's own title, the way a message box reports its subject.
export component MessageDialog inherits Window {
    title: root.heading;
    width: 380px;
    height: body.preferred-height + 2 * Win10.frame-width;
    always-on-top: true;
    default-font-family: "WeblySleek UI";

    in property <string> heading: "";
    in property <string> text: "";

    callback accepted();

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: Win10.face-color;
        border-width: Win10.frame-width;
        border-color: Win10.frame-color;

        body := VerticalLayout {
            padding: 14px;
            spacing: 12px;

            Text {
                text: root.text;
                wrap: word-wrap;
                vertical-stretch: 1;
                horizontal-stretch: 1;
                font-size: Win10.font-size;
                color: Win10.text-color;
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                horizontal-stretch: 1;

                WinButton {
                    text: "OK";
                    is-default: true;
                    clicked => { root.accepted(); }
                }
            }
        }
    }
}
