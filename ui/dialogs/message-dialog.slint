import { Button } from "std-widgets.slint";
import { DialogState } from "../globals.slint";
import { Styles } from "../styles.slint";

// A plain message with one way out. It covers the whole window so nothing
// behind it can be reached while it is up.
export component MessageDialog inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #00000040;

    TouchArea {}

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 400px;
        height: 160px;
        background: white;
        border-width: 1px;
        border-color: Styles.bar-border-light;

        VerticalLayout {
            padding: 10px;
            spacing: 8px;

            Text {
                text: DialogState.message-title;
                font-size: Styles.bar-font-size + 2px;
                font-weight: 700;
                color: Styles.bar-text-color;
                horizontal-stretch: 1;
            }

            Text {
                text: DialogState.message-text;
                wrap: word-wrap;
                vertical-stretch: 1;
                horizontal-stretch: 1;
                color: Styles.bar-text-color;
            }

            HorizontalLayout {
                alignment: end;
                horizontal-stretch: 1;
                Button {
                    text: "OK";
                    primary: true;
                    clicked => { DialogState.message-ok(); }
                }
            }
        }
    }
}
