import { Button, ComboBox, LineEdit, ListView } from "std-widgets.slint";
import { DialogState, EFileDialogMode } from "../globals.slint";
import { Styles } from "../styles.slint";

// A file picker drawn by the application itself: the listing, the name box and
// the format choice are ours, so it looks and behaves the same everywhere.
export component FileDialog inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #00000040;

    TouchArea {}

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 560px;
        height: 480px;
        background: white;
        border-width: 1px;
        border-color: Styles.bar-border-light;

        VerticalLayout {
            padding: 8px;
            spacing: 6px;

            Text {
                text: DialogState.file-title;
                font-size: Styles.bar-font-size + 2px;
                font-weight: 700;
                color: Styles.bar-text-color;
                horizontal-stretch: 1;
            }

            HorizontalLayout {
                spacing: 6px;

                directory := Text {
                    text: DialogState.file-directory;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                    font-size: Styles.bar-font-size;
                    color: Styles.bar-text-color;
                }

                Button {
                    text: "Up";
                    clicked => { DialogState.file-up(); }
                }
            }

            Rectangle {
                height: 240px;
                border-width: 1px;
                border-color: Styles.bar-border-light;

                ListView {
                    for label[i] in DialogState.file-labels : Rectangle {
                        height: 24px;
                        background: row.has-hover ? Styles.menu-hover : transparent;

                        row := TouchArea {
                            clicked => { DialogState.file-navigate(i); }
                        }

                        Text {
                            text: label;
                            x: 4px;
                            vertical-alignment: center;
                            overflow: elide;
                            font-size: Styles.bar-font-size;
                            color: Styles.bar-text-color;
                        }
                    }
                }
            }

            if (DialogState.file-mode == EFileDialogMode.SAVE) : ComboBox {
                model: ["PNG (*.png)", "BMP (*.bmp)", "JPEG (*.jpg)"];
                current-index: DialogState.file-format;
                horizontal-stretch: 1;
                changed current-index => { DialogState.file-filter-changed(self.current-index); }
            }
            if (DialogState.file-mode != EFileDialogMode.SAVE) : ComboBox {
                model: ["Images (*.png;*.bmp;*.jpg;*.jpeg)", "All files (*)"];
                current-index: DialogState.file-filter;
                horizontal-stretch: 1;
                changed current-index => { DialogState.file-filter-changed(self.current-index); }
            }

            path-input := LineEdit {
                text <=> DialogState.file-path;
                horizontal-stretch: 1;
                accepted(text) => { DialogState.file-ok(); }
                init => { self.focus(); }
            }

            Text {
                visible: DialogState.file-has-error;
                text: DialogState.file-error;
                wrap: word-wrap;
                font-size: Styles.bar-font-size;
                color: #b00020;
                horizontal-stretch: 1;
            }

            HorizontalLayout {
                alignment: end;
                spacing: 6px;
                horizontal-stretch: 1;

                Button {
                    text: "Cancel";
                    clicked => { DialogState.file-cancel(); }
                }
                Button {
                    text: DialogState.file-accept-text;
                    primary: true;
                    clicked => { DialogState.file-ok(); }
                }
            }
        }
    }
}
