import { Styles } from "../styles.slint";

export component Bar inherits Rectangle {
    cache-rendering-hint: true;
    height: Styles.bar-height;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    border-radius: 0;
    background: Styles.ribbon-background;
    border-width: 0;

    visible: root.width > 100px;

    // A hairline under the ribbon, in the grey the dividers between its groups
    // use.
    Rectangle {
        y: root.height - 1phx;
        width: 100%;
        height: 1phx;
        background: Styles.ribbon-divider-color;
    }
}

export component BarDivider inherits Rectangle {
    height: 90px;
    width: Styles.ribbon-divider;
    y: (Styles.bar-height - root.height) / 2;
    background: Styles.ribbon-divider-color;
}

export component BarItemGroup {
    cache-rendering-hint: true;
    in-out property <string> title;
    // False when the group is merged into one button that already carries the
    // group's name, which would otherwise read twice.
    in property <bool> show-title: true;

    height: Styles.bar-height;
    min-width: 45px;

    VerticalLayout {
        alignment: start;

        HorizontalLayout {
            padding-left: Styles.ribbon-group-padding;
            padding-right: Styles.ribbon-group-padding;
            padding-bottom: Styles.bar-padding;
            padding-top: 5px;
            height: Styles.bar-button-height;

            @children
        }
    }

    Text {
        visible: show-title;
        text: title;
        y: Styles.bar-height - Styles.bar-font-size - 2 * Styles.bar-padding;
        color: #555;
        font-size: Styles.bar-font-size;
        horizontal-alignment: center;
        wrap: no-wrap;
        overflow: elide;
    }
}
