import { Bar, BarDivider, BarItemGroup } from "bar.slint";
import { ImageButtonVertical, ImageButtonHorizontal, ImageButtonIcon, ImageButtonVerticalDropdown, ColorButtonVertical, ColorButton } from "../components/image-buttons.slint";
import { BarDropdown, BarDropdownItem, BarDropdownTitle, BarDropdownDivider, BarSizeDropdownItem } from "../components/bar-dropdown.slint";
import { StandardButton, AboutSlint } from "std-widgets.slint";
import { Styles } from "../styles.slint";
import { UserState, DocumentState, ETool, ESelectionType, ERotation, ToolOptions, EShapeKind, EShapeMode, ShapeStyle, ShapeGallery } from "../globals.slint";

// One glyph of the Shapes picker.
component ShapeGlyphButton inherits Rectangle {
    in property <string> commands;
    in property <bool> focused: false;
    callback clicked;

    width: Styles.bar-small-icon-size + 6px;
    height: Styles.bar-small-icon-size + 6px;
    border-width: 1px;
    border-color: focused ? #8dbcec : touch.has-hover ? #c3ddf8 : transparent;
    background: focused ? #c9e0f7 : touch.pressed ? #d5e6f7 : transparent;

    Path {
        x: 3px;
        y: 3px;
        width: root.width - 6px;
        height: root.height - 6px;
        viewbox-width: 26.0;
        viewbox-height: 26.0;
        commands: root.commands;
        fill: transparent;
        stroke: Styles.bar-text-color;
        stroke-width: 1px;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The button that carries the shape the tool would draw next, and opens the
// picker with every kind.
component ShapePickerButton inherits Rectangle {
    in property <string> commands;
    in property <string> text: "";
    in property <bool> focused: false;
    callback clicked;

    height: root.text == "" ? Styles.bar-small-icon-size + 6px : Styles.bar-small-icon-size + 20px;
    border-width: 1px;
    border-color: focused ? #8dbcec : touch.has-hover ? #c3ddf8 : transparent;
    background: focused ? #c9e0f7 : touch.pressed ? #d5e6f7 : transparent;

    VerticalLayout {
        padding: 3px;
        spacing: 0px;
        alignment: center;

        HorizontalLayout {
            spacing: 1px;
            alignment: center;

            Path {
                width: Styles.bar-small-icon-size;
                height: Styles.bar-small-icon-size;
                viewbox-width: 26.0;
                viewbox-height: 26.0;
                commands: root.commands;
                fill: transparent;
                stroke: Styles.bar-text-color;
                stroke-width: 1px;
            }

            Text {
                text: "▾";
                font-size: Styles.bar-font-size;
                color: Styles.bar-text-color;
                vertical-alignment: center;
            }
        }

        // The merged button names its group, like the other merged groups do.
        if (root.text != "") : Text {
            text: root.text;
            font-size: Styles.bar-font-size;
            color: Styles.bar-text-color;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component HomeBar inherits Bar {
    // Groups merge into a single button as the ribbon narrows. A group collapses
    // once the ribbon can no longer hold it together with every group that does not
    // collapse before it, so the ribbon never runs out of room and no group keeps
    // less than the width its contents need.
    //
    // The width arrives through a changed handler instead of a binding: the layout
    // below decides how wide the strip is, so reading that width back into the
    // condition would close a binding loop.
    private property <length> strip-width: 0px;
    changed width => { root.strip-width = self.width; }

    // The groups give way from the left: the Clipboard merges first and the
    // Colors group last, so the palette stays up for as long as the ribbon can
    // hold it. A group merges once the ribbon is narrower than the groups up to
    // and including it, every one of them showing its full content, so no group
    // is ever squeezed and the ribbon never runs out of room.
    //
    // The span-* sums are constant. Only a group's own width-* property is
    // decided by its own condition, and each condition reads the width-*
    // properties of the groups to its left, which are already decided.
    private property <length> span-image:
        Styles.ribbon-width-image + Styles.ribbon-divider + Styles.ribbon-width-tools
            + Styles.ribbon-divider + Styles.ribbon-width-brushes + Styles.ribbon-divider
            + Styles.ribbon-width-shapes + Styles.ribbon-divider + Styles.ribbon-width-size
            + Styles.ribbon-divider + Styles.ribbon-width-colors + Styles.ribbon-divider
            + effective-about;
    private property <length> span-tools:
        Styles.ribbon-width-tools + Styles.ribbon-divider + Styles.ribbon-width-brushes
            + Styles.ribbon-divider + Styles.ribbon-width-shapes + Styles.ribbon-divider
            + Styles.ribbon-width-size + Styles.ribbon-divider + Styles.ribbon-width-colors
            + Styles.ribbon-divider + effective-about;
    private property <length> span-shapes:
        Styles.ribbon-width-shapes + Styles.ribbon-divider + Styles.ribbon-width-size
            + Styles.ribbon-divider + Styles.ribbon-width-colors + Styles.ribbon-divider
            + effective-about;
    private property <length> span-colors:
        Styles.ribbon-width-colors + Styles.ribbon-divider + effective-about;

    private property <bool> collapsed-clipboard:
        root.strip-width < Styles.ribbon-width-clipboard + Styles.ribbon-divider + span-image
            + Styles.ribbon-overflow-margin;    private property <length> width-clipboard:
        collapsed-clipboard ? Styles.ribbon-merged-width : Styles.ribbon-width-clipboard;

    // The About group is an addition of this build, so it is the first thing to
    // go: it shows only while the whole ribbon fits expanded. Reading constants
    // only keeps this out of the collapse conditions' dependency chain.
    private property <bool> about-fits:
        root.strip-width >= Styles.ribbon-width-clipboard + Styles.ribbon-divider
            + Styles.ribbon-width-image + Styles.ribbon-divider + Styles.ribbon-width-tools
            + Styles.ribbon-divider + Styles.ribbon-width-brushes + Styles.ribbon-divider
            + Styles.ribbon-width-shapes + Styles.ribbon-divider + Styles.ribbon-width-size
            + Styles.ribbon-divider + Styles.ribbon-width-colors + Styles.ribbon-divider
            + Styles.ribbon-width-about + Styles.ribbon-overflow-margin;
    // What the About group costs the ribbon while it is showing.
    private property <length> effective-about:
        root.about-fits ? Styles.ribbon-width-about + Styles.ribbon-divider : 0px;

    private property <bool> collapsed-image:
        root.strip-width < width-clipboard + Styles.ribbon-divider + span-image
            + Styles.ribbon-overflow-margin;
    private property <length> width-image:
        collapsed-image ? Styles.ribbon-merged-width : Styles.ribbon-width-image;

    private property <bool> collapsed-tools:
        root.strip-width < width-clipboard + Styles.ribbon-divider + width-image
            + Styles.ribbon-divider + span-tools + Styles.ribbon-overflow-margin;
    private property <length> width-tools:
        collapsed-tools ? Styles.ribbon-merged-width : Styles.ribbon-width-tools;

    private property <bool> collapsed-shapes:
        root.strip-width < width-clipboard + Styles.ribbon-divider + width-image
            + Styles.ribbon-divider + width-tools + Styles.ribbon-divider
            + Styles.ribbon-width-brushes + Styles.ribbon-divider + span-shapes
            + Styles.ribbon-overflow-margin;
    private property <length> width-shapes:
        collapsed-shapes ? Styles.ribbon-merged-width : Styles.ribbon-width-shapes;

    private property <bool> collapsed-colors:
        root.strip-width < width-clipboard + Styles.ribbon-divider + width-image
            + Styles.ribbon-divider + width-tools + Styles.ribbon-divider
            + Styles.ribbon-width-brushes + Styles.ribbon-divider + width-shapes
            + Styles.ribbon-divider + Styles.ribbon-width-size + Styles.ribbon-divider
            + span-colors + Styles.ribbon-overflow-margin;
    private property <length> width-colors:
        collapsed-colors ? Styles.ribbon-merged-width : Styles.ribbon-width-colors;

    // A brush preset is a tip, a size and how closely the stamps are laid down.
    // All three take effect on the next stroke.
    function use-brush-preset(size: length, square: bool, spacing: float) {
        ToolOptions.brush-size = size;
        ToolOptions.brush-square = square;
        ToolOptions.brush-spacing = spacing;
    }

    HorizontalLayout {
        grp-clipboard := BarItemGroup {
            title: "Clipboard";
            show-title: !collapsed-clipboard;
            width: width-clipboard;

            clipboard-dropdown := PopupWindow {
                y: Styles.bar-height - Styles.bar-padding;
                x: clipboard-dropdown-btn.x + Styles.bar-padding;

                BarDropdown {
                    BarDropdownItem {
                        icon: @image-url("../../icons/paste.png"); text: "Paste";
                        enabled: DocumentState.has-clipboard;
                        clicked => { UserState.paste-selection(); }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/paste.png"); text: "Paste from file";
                        enabled: false;
                    }
                    BarDropdownDivider {}
                    BarDropdownItem {
                        icon: @image-url("../../icons/cut.png"); text: "Cut";
                        enabled: DocumentState.has-selection;
                        clicked => { UserState.cut-selection(); }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/copy.png"); text: "Copy";
                        enabled: DocumentState.has-selection;
                        clicked => { UserState.copy-selection(); }
                    }
                }
            }

            HorizontalLayout {
                clipboard-dropdown-btn := ImageButtonVerticalDropdown {
                    text: "Paste";
                    icon: @image-url("../../icons/paste.png");

                    clicked => { UserState.paste-selection(); }
                    clicked_dropdown => { clipboard-dropdown.show(); }
                }

                VerticalLayout {
                    visible: !collapsed-clipboard;
                    max-width: 70px;
                    spacing: Styles.bar-list-spacing;

                    ImageButtonHorizontal {
                        icon: @image-url("../../icons/cut.png");
                        text: "Cut";
                        enabled: DocumentState.has-selection;
                        clicked => { UserState.cut-selection(); }
                    }
                    ImageButtonHorizontal {
                        icon: @image-url("../../icons/copy.png");
                        text: "Copy";
                        enabled: DocumentState.has-selection;
                        clicked => { UserState.copy-selection(); }
                    }
                }
            }
        }
        BarDivider {}

        grp-image := BarItemGroup {
            title: "Image";
            show-title: !collapsed-image;
            width: width-image;

            rotate-dropdown := PopupWindow {
                y: Styles.bar-height - Styles.bar-padding;
                x: rotate-btn.x;

                BarDropdown {
                    BarDropdownItem {
                        icon: @image-url("../../icons/rotate.png"); text: "Rotate 90° CW";
                        clicked => { UserState.rotate(ERotation.CW90); }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/rotate.png"); text: "Rotate 90° CCW";
                        clicked => { UserState.rotate(ERotation.CCW90); }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/rotate.png"); text: "Rotate 180°";
                        clicked => { UserState.rotate(ERotation.R180); }
                    }
                    BarDropdownDivider {}
                    BarDropdownItem {
                        icon: @image-url("../../icons/rotate.png"); text: "Flip horizontal";
                        clicked => { UserState.flip-horizontal(); }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/rotate.png"); text: "Flip vertical";
                        clicked => { UserState.flip-vertical(); }
                    }
                }
            }

            select-dropdown := PopupWindow {
                y: Styles.bar-height - Styles.bar-padding;
                x: select-dropdown-btn.x + Styles.bar-padding;

                BarDropdown {
                    BarDropdownTitle { text: "Selection Shapes"; }
                    BarDropdownDivider {}
    
                    BarDropdownItem {
                        icon: @image-url("../../icons/selection.png"); text: "Rectangular selection";
                        focused: UserState.selection-type == ESelectionType.RECTANGULAR;
                        clicked => { UserState.select-shape(ESelectionType.RECTANGULAR); }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/free-selection.png"); text: "Free-hand selection";
                        focused: UserState.selection-type == ESelectionType.FREEHAND;
                        clicked => { UserState.select-shape(ESelectionType.FREEHAND); }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/selection.png"); text: "Polygon selection";
                        focused: UserState.selection-type == ESelectionType.POLYGON;
                        clicked => { UserState.select-shape(ESelectionType.POLYGON); }
                    }

                    BarDropdownDivider {}
                    BarDropdownTitle { text: "Selection Options"; }
                    BarDropdownDivider {}

                    BarDropdownItem {
                        icon: @image-url("../../icons/select-all.png"); text: "Select all";
                        clicked => { UserState.select-all(); }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/invert-selection.png"); text: "Invert selection";
                        clicked => { UserState.invert-selection(); }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/clear-selection.png"); text: "Clear selection";
                        clicked => { UserState.clear-selection(); }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/transparent-selection.png"); text: "Transparent selection";
                        clicked => { UserState.transparent-selection(); }
                    }
                }
            }

            image-menu := PopupWindow {
                y: Styles.bar-height - Styles.bar-padding;
                x: image-merged.x;

                BarDropdown {
                    BarDropdownItem {
                        icon: @image-url("../../icons/select-all.png"); text: "Select all";
                        clicked => { UserState.select-all(); }
                    }
                    BarDropdownDivider {}
                    BarDropdownItem {
                        icon: @image-url("../../icons/crop.png"); text: "Crop";
                        enabled: DocumentState.has-selection;
                        clicked => { UserState.crop-to-selection(); }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/resize.png"); text: "Resize";
                        clicked => { UserState.resize-dialog(); }
                    }
                    BarDropdownDivider {}
                    BarDropdownItem {
                        icon: @image-url("../../icons/rotate.png"); text: "Rotate 90° CW";
                        clicked => { UserState.rotate(ERotation.CW90); }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/rotate.png"); text: "Rotate 90° CCW";
                        clicked => { UserState.rotate(ERotation.CCW90); }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/rotate.png"); text: "Rotate 180°";
                        clicked => { UserState.rotate(ERotation.R180); }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/rotate.png"); text: "Flip horizontal";
                        clicked => { UserState.flip-horizontal(); }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/rotate.png"); text: "Flip vertical";
                        clicked => { UserState.flip-vertical(); }
                    }
                }
            }

            image-merged := ImageButtonVerticalDropdown {
                visible: collapsed-image;
                // No width while the group is expanded: an invisible element
                // still holds its slot, which would squeeze the group's content.
                width: collapsed-image ? Styles.ribbon-merged-button : 0px;
                text: "Image";
                icon: @image-url("../../icons/resize.png");
                clicked => { image-menu.show(); }
                clicked_dropdown => { image-menu.show(); }
            }

            HorizontalLayout {
                visible: !collapsed-image;
                select-dropdown-btn := ImageButtonVerticalDropdown {
                    text: "Select";
                    icon: 
                        UserState.selection-type == ESelectionType.RECTANGULAR ? @image-url("../../icons/selection.png") :
                        UserState.selection-type == ESelectionType.FREEHAND ? @image-url("../../icons/free-selection.png") :
                        @image-url("../../icons/selection.png");
                    focused1: UserState.selected-tool == ETool.SELECTION;
                    focused2: UserState.selected-tool == ETool.SELECTION;

                    clicked => { UserState.selected-tool = ETool.SELECTION; }
                    clicked_dropdown => {
                        select-dropdown.show();
                        UserState.selected-tool = ETool.SELECTION;
                    }
                }

                VerticalLayout {
                    max-width: 80px;
                    spacing: Styles.bar-list-spacing;

                    ImageButtonHorizontal {
                        text: "Crop";
                        icon: @image-url("../../icons/crop.png");
                        enabled: DocumentState.has-selection;
                        clicked => { UserState.crop-to-selection(); }
                    }
                    ImageButtonHorizontal {
                        text: "Resize";
                        icon: @image-url("../../icons/resize.png");
                        clicked => { UserState.resize-dialog(); }
                    }
                    rotate-btn := ImageButtonHorizontal {
                        text: "Rotate ▾";
                        icon: @image-url("../../icons/rotate.png");
                        clicked => { rotate-dropdown.show(); }
                    }
                }
            }
        }

        BarDivider {}

        grp-tools := BarItemGroup {
            title: "Tools";
            show-title: !collapsed-tools;
            width: width-tools;

            tools-menu := PopupWindow {
                y: Styles.bar-height - Styles.bar-padding;
                x: tools-merged.x;

                BarDropdown {
                    BarDropdownItem {
                        icon: @image-url("../../icons/pencil.png"); text: "Pencil";
                        focused: UserState.selected-tool == ETool.PENCIL;
                        clicked => { UserState.selected-tool = ETool.PENCIL; }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/paint.png"); text: "Fill with color";
                        focused: UserState.selected-tool == ETool.FILL;
                        clicked => { UserState.selected-tool = ETool.FILL; }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/text.png"); text: "Text";
                        focused: UserState.selected-tool == ETool.TEXT;
                        clicked => { UserState.selected-tool = ETool.TEXT; }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/eraser.png"); text: "Eraser";
                        focused: UserState.selected-tool == ETool.ERASER;
                        clicked => { UserState.selected-tool = ETool.ERASER; }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/colorpicker.png"); text: "Color picker";
                        focused: UserState.selected-tool == ETool.DROPPER;
                        clicked => { UserState.selected-tool = ETool.DROPPER; }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/magnify.png"); text: "Magnifier";
                        focused: UserState.selected-tool == ETool.MAGNIFY;
                        clicked => { UserState.selected-tool = ETool.MAGNIFY; }
                    }
                }
            }

            tools-merged := ImageButtonVerticalDropdown {
                visible: collapsed-tools;
                // No width while the group is expanded: an invisible element
                // still holds its slot, which would squeeze the group's content.
                width: collapsed-tools ? Styles.ribbon-merged-button : 0px;
                text: "Tools";
                icon: @image-url("../../icons/pencil.png");
                clicked => { tools-menu.show(); }
                clicked_dropdown => { tools-menu.show(); }
            }

            GridLayout {
                visible: !collapsed-tools;
                spacing: Styles.bar-padding;
                padding-top: Styles.bar-padding;

                Row {
                    ImageButtonIcon{
                        icon: @image-url("../../icons/pencil.png");
                        focused: UserState.selected-tool == ETool.PENCIL;
                        clicked => { UserState.selected-tool = ETool.PENCIL; }
                    }
                    ImageButtonIcon{
                        icon: @image-url("../../icons/paint.png");
                        focused: UserState.selected-tool == ETool.FILL;
                        clicked => { UserState.selected-tool = ETool.FILL; }
                    }
                    ImageButtonIcon{
                        icon: @image-url("../../icons/text.png");
                        focused: UserState.selected-tool == ETool.TEXT;
                        clicked => { UserState.selected-tool = ETool.TEXT; }
                    }
                }
                Row {
                    ImageButtonIcon{
                        icon: @image-url("../../icons/eraser.png");
                        focused: UserState.selected-tool == ETool.ERASER;
                        clicked => { UserState.selected-tool = ETool.ERASER; }

                    }
                    ImageButtonIcon{
                        icon: @image-url("../../icons/colorpicker.png");
                        focused: UserState.selected-tool == ETool.DROPPER;
                        clicked => { UserState.selected-tool = ETool.DROPPER; }
                    }
                    ImageButtonIcon{
                        icon: @image-url("../../icons/magnify.png");
                        focused: UserState.selected-tool == ETool.MAGNIFY;
                        clicked => { UserState.selected-tool = ETool.MAGNIFY; }
                    }
                }
            }
        }

        BarDivider {}

        grp-brushes := BarItemGroup {
            title: "";
            brushes-btn := ImageButtonVerticalDropdown {
                // "Brushes" is the longest group name, so its button is wider
                // than the other merged buttons.
                width: Styles.ribbon-merged-button + 8px;
                text: "Brushes";
                clicked => { brushes-dropdown.show(); }
                clicked_dropdown => { brushes-dropdown.show(); }
            }
        }

        brushes-dropdown := PopupWindow {
            // Declared at the ribbon level, so the button's position inside its
            // group needs the group's own offset added.
            y: Styles.bar-height - Styles.bar-padding;
            x: grp-brushes.x + brushes-btn.x;

            BarDropdown {
                BarSizeDropdownItem {
                    text: "Pencil 1 px"; size: 1px;
                    clicked => { root.use-brush-preset(1px, false, 0.25); }
                }
                BarSizeDropdownItem {
                    text: "Round 4 px"; size: 4px;
                    clicked => { root.use-brush-preset(4px, false, 0.25); }
                }
                BarSizeDropdownItem {
                    text: "Round 8 px"; size: 8px;
                    clicked => { root.use-brush-preset(8px, false, 0.25); }
                }
                BarSizeDropdownItem {
                    text: "Round 16 px"; size: 16px;
                    clicked => { root.use-brush-preset(16px, false, 0.25); }
                }
                BarSizeDropdownItem {
                    text: "Square 4 px"; size: 4px;
                    clicked => { root.use-brush-preset(4px, true, 0.25); }
                }
                BarSizeDropdownItem {
                    text: "Square 12 px"; size: 12px;
                    clicked => { root.use-brush-preset(12px, true, 0.25); }
                }
                BarSizeDropdownItem {
                    text: "Dotted 8 px"; size: 8px;
                    clicked => { root.use-brush-preset(8px, false, 1.0); }
                }
            }
        }

        BarDivider {}

        grp-shapes := BarItemGroup {
            title: "Shapes";
            // The merged button carries the group name already.
            show-title: !collapsed-shapes;
            width: width-shapes;

            shape-gallery-dropdown := PopupWindow {
                y: Styles.bar-height - Styles.bar-padding;
                x: collapsed-shapes ? shape-merged.x : shape-box.x;

                BarDropdown {
                    HorizontalLayout {
                        padding: 6px;

                        Rectangle {
                            width: 7 * (Styles.bar-small-icon-size + 6px);
                            height: 4 * (Styles.bar-small-icon-size + 6px);

                            for glyph[i] in ShapeGallery.items: ShapeGlyphButton {
                                x: mod(i, 7) * (Styles.bar-small-icon-size + 6px);
                                y: floor(i / 7) * (Styles.bar-small-icon-size + 6px);
                                commands: glyph.commands;
                                focused: ShapeStyle.kind == glyph.kind;
                                clicked => {
                                    ShapeStyle.kind = glyph.kind;
                                    UserState.selected-tool = ETool.SHAPE;
                                    shape-gallery-dropdown.close();
                                }
                            }
                        }
                    }

                    // Merged away, the outline and thickness buttons have no home
                    // of their own, so the picker carries them.
                    BarDropdownDivider {}
                    BarDropdownItem {
                        icon: @image-url("../../icons/shape-outline.png");
                        text: "Outline";
                        focused: ShapeStyle.mode != EShapeMode.FILL;
                        clicked => {
                            if (ShapeStyle.mode == EShapeMode.FILL) { ShapeStyle.mode = EShapeMode.BOTH; }
                            shape-gallery-dropdown.close();
                        }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/shape-fill.png");
                        text: "Fill";
                        focused: ShapeStyle.mode != EShapeMode.OUTLINE;
                        clicked => {
                            if (ShapeStyle.mode == EShapeMode.OUTLINE) { ShapeStyle.mode = EShapeMode.BOTH; }
                            shape-gallery-dropdown.close();
                        }
                    }
                    BarDropdownTitle { text: "Thickness"; }
                    BarDropdownDivider {}
                    BarDropdownItem {
                        text: "Thin (1px)";
                        focused: ShapeStyle.thickness == 1;
                        clicked => { ShapeStyle.thickness = 1; shape-gallery-dropdown.close(); }
                    }
                    BarDropdownItem {
                        text: "Medium (4px)";
                        focused: ShapeStyle.thickness == 4;
                        clicked => { ShapeStyle.thickness = 4; shape-gallery-dropdown.close(); }
                    }
                    BarDropdownItem {
                        text: "Thick (8px)";
                        focused: ShapeStyle.thickness == 8;
                        clicked => { ShapeStyle.thickness = 8; shape-gallery-dropdown.close(); }
                    }
                }
            }

            outline-dropdown := PopupWindow {
                y: Styles.bar-height - Styles.bar-padding;
                x: outline-btn.x;

                BarDropdown {
                    BarDropdownItem {
                        icon: @image-url("../../icons/shape-outline.png");
                        text: "Solid color";
                        focused: ShapeStyle.mode != EShapeMode.FILL;
                        clicked => {
                            // Solid colour turns the outline on and leaves the
                            // fill choice alone.
                            if (ShapeStyle.mode == EShapeMode.FILL) { ShapeStyle.mode = EShapeMode.BOTH; }
                            outline-dropdown.close();
                        }
                    }
                    BarDropdownItem {
                        text: "No outline";
                        focused: ShapeStyle.mode == EShapeMode.FILL;
                        clicked => {
                            // A shape with neither outline nor fill would be invisible.
                            ShapeStyle.mode = EShapeMode.FILL;
                            outline-dropdown.close();
                        }
                    }
                }
            }

            fill-dropdown := PopupWindow {
                y: Styles.bar-height - Styles.bar-padding;
                x: fill-btn.x;

                BarDropdown {
                    BarDropdownItem {
                        icon: @image-url("../../icons/shape-fill.png");
                        text: "Solid color";
                        focused: ShapeStyle.mode != EShapeMode.OUTLINE;
                        clicked => {
                            // Solid colour turns the fill on and leaves the
                            // outline choice alone.
                            if (ShapeStyle.mode == EShapeMode.OUTLINE) { ShapeStyle.mode = EShapeMode.BOTH; }
                            fill-dropdown.close();
                        }
                    }
                    BarDropdownItem {
                        text: "No fill";
                        focused: ShapeStyle.mode == EShapeMode.OUTLINE;
                        clicked => {
                            if (ShapeStyle.mode != EShapeMode.OUTLINE) { ShapeStyle.mode = EShapeMode.OUTLINE; }
                            fill-dropdown.close();
                        }
                    }
                }
            }

            shape-merged := ShapePickerButton {
                visible: collapsed-shapes;
                // No width while the group is expanded: an invisible element
                // still holds its slot, which would squeeze the group's content.
                width: collapsed-shapes ? Styles.ribbon-merged-button : 0px;
                commands: ShapeGallery.current-commands;
                text: "Shapes";
                focused: UserState.selected-tool == ETool.SHAPE;
                clicked => {
                    UserState.selected-tool = ETool.SHAPE;
                    shape-gallery-dropdown.show();
                }
            }

            Rectangle {
                visible: !collapsed-shapes;
                width: collapsed-shapes ? 0px : 8 * Styles.ribbon-shape-cell;
                height: 3 * Styles.ribbon-shape-cell;

                // The shape box: every kind the tool offers, three rows of eight.
                shape-box := Rectangle {
                    x: 0px;
                    y: 0px;
                    width: 8 * Styles.ribbon-shape-cell;
                    height: 3 * Styles.ribbon-shape-cell;
                    clip: true;

                    for glyph[i] in ShapeGallery.items: ShapeGlyphButton {
                        x: mod(i, 8) * Styles.ribbon-shape-cell;
                        y: floor(i / 8) * Styles.ribbon-shape-cell;
                        commands: glyph.commands;
                        focused: ShapeStyle.kind == glyph.kind;
                        clicked => {
                            ShapeStyle.kind = glyph.kind;
                            UserState.selected-tool = ETool.SHAPE;
                        }
                    }
                }
            }

            // The outline and fill choices are part of the expanded group only;
            // the merged button carries them inside the gallery popup.
            VerticalLayout {
                visible: !collapsed-shapes;
                width: collapsed-shapes ? 0px : 96px;
                alignment: center;
                spacing: Styles.bar-list-spacing;

                outline-btn := ImageButtonHorizontal {
                    width: 96px;
                    text: "Outline ▾";
                    icon: @image-url("../../icons/shape-outline.png");
                    clicked => { outline-dropdown.show(); }
                }

                fill-btn := ImageButtonHorizontal {
                    width: 96px;
                    text: "Fill ▾";
                    icon: @image-url("../../icons/shape-fill.png");
                    clicked => { fill-dropdown.show(); }
                }
            }
        }

        BarDivider {}

        grp-size := BarItemGroup {
            title: "";

            size-dropdown := PopupWindow {
                y: Styles.bar-height - Styles.bar-padding;
                x: size-dropdown-btn.x;

                BarDropdown {
                    BarSizeDropdownItem {
                        text: "1px"; size: 1px;
                        clicked => { ToolOptions.brush-size = self.size; ShapeStyle.thickness = 1; }
                    }
                    BarSizeDropdownItem {
                        text: "2px"; size: 2px;
                        clicked => { ToolOptions.brush-size = self.size; ShapeStyle.thickness = 2; }
                    }
                    BarSizeDropdownItem {
                        text: "3px"; size: 3px;
                        clicked => { ToolOptions.brush-size = self.size; ShapeStyle.thickness = 3; }
                    }
                    BarSizeDropdownItem {
                        text: "4px"; size: 4px;
                        clicked => { ToolOptions.brush-size = self.size; ShapeStyle.thickness = 4; }
                    }
                    BarSizeDropdownItem {
                        text: "5px"; size: 5px;
                        clicked => { ToolOptions.brush-size = self.size; ShapeStyle.thickness = 5; }
                    }
                    BarSizeDropdownItem {
                        text: "8px"; size: 8px;
                        clicked => { ToolOptions.brush-size = self.size; ShapeStyle.thickness = 8; }
                    }
                    BarSizeDropdownItem {
                        text: "10px"; size: 10px;
                        clicked => { ToolOptions.brush-size = self.size; ShapeStyle.thickness = 10; }
                    }
                }
            }

            size-dropdown-btn := ImageButtonVerticalDropdown {
                text: "Size";
                icon: @image-url("../../icons/size.png");

                clicked => {
                    size-dropdown.show();
                    size-dropdown-btn.focused1 = true;
                    size-dropdown-btn.focused2 = true;
                }
                clicked_dropdown => {
                    size-dropdown.show();
                    size-dropdown-btn.focused1 = true;
                    size-dropdown-btn.focused2 = true;
                }
            }
        }

        BarDivider {}

        grp-colors := BarItemGroup {
            title: "Colors";
            show-title: !collapsed-colors;
            width: collapsed-colors ? Styles.ribbon-merged-width : Styles.ribbon-width-colors;

            colors-menu := PopupWindow {
                y: Styles.bar-height - Styles.bar-padding;
                x: colors-merged.x - 100px;

                BarDropdown {
                    BarDropdownItem {
                        text: "Color 1";
                        focused: UserState.color_idx == 0;
                        clicked => { UserState.color_idx = 0; }
                    }
                    BarDropdownItem {
                        text: "Color 2";
                        focused: UserState.color_idx == 1;
                        clicked => { UserState.color_idx = 1; }
                    }
                    BarDropdownDivider {}
                    HorizontalLayout {
                        padding: 6px;

                        Rectangle {
                            width: (Styles.bar-small-icon-size + Styles.color-btn-spacing) * 10;
                            height: (Styles.bar-small-icon-size + Styles.color-btn-spacing) * 2;

                            for color[i] in UserState.color_palette: ColorButton {
                                x: mod(i, 10) * (Styles.bar-small-icon-size + Styles.color-btn-spacing);
                                y: floor(i / 10) * (Styles.bar-small-icon-size + Styles.color-btn-spacing);
                                colr: color;
                                clicked => {
                                    if (UserState.color_idx == 0) {
                                        UserState.primary-color = color;
                                    } else {
                                        UserState.secondary-color = color;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                // Wrapped in `if` and not hidden with `visible`: an invisible element
                // still holds its slot in the layout, so the group would not give the
                // space back when it collapses.
                if (!collapsed-colors) : HorizontalLayout {
                    ColorButtonVertical {
                        width: 50px;
                        colr: UserState.primary-color;
                        // Wrapped like Paint's, so the caption never elides.
                        text: "Color\n1";
                        focused: UserState.color_idx == 0;
                        clicked => { UserState.color_idx = 0; }
                    }
                    ColorButtonVertical {
                        width: 50px;
                        colr: UserState.secondary-color;
                        text: "Color\n2";
                        focused: UserState.color_idx == 1;
                        clicked => { UserState.color_idx = 1; }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;

                        Rectangle {
                            width: (Styles.bar-small-icon-size + Styles.color-btn-spacing) * 10;

                            for color[i] in UserState.color_palette:
                                ColorButton {
                                    x: mod(i, 10) * (Styles.bar-small-icon-size + Styles.color-btn-spacing);
                                    y: floor(i / 10) * (Styles.bar-small-icon-size + Styles.color-btn-spacing);
                                    colr: color;
                                    clicked => {
                                        if (UserState.color_idx == 0) {
                                            UserState.primary-color = color;
                                        } else {
                                            UserState.secondary-color = color;
                                        }
                                    }
                                }
                        }
                    }

                    ImageButtonVertical {
                        width: 70px;
                        // Two lines, as Paint draws it, so the caption never elides.
                        text: "Edit\ncolors";
                        icon: @image-url("../../icons/edit-colors.png");
                    }
                }

                colors-merged := ImageButtonVerticalDropdown {
                    visible: collapsed-colors;
                    width: collapsed-colors ? Styles.ribbon-merged-button : 0px;
                    text: "Colors";
                    clicked => { colors-menu.show(); }
                    clicked_dropdown => { colors-menu.show(); }
                }
            }
        }

        BarDivider {}

        grp-about := BarItemGroup {
            title: "";
            visible: about-fits;
            width: about-fits ? Styles.ribbon-width-about : 0px;
            ImageButtonVertical {
                width: 76px;
                icon: @image-url("../../icons/about.png");
                text: "About";

                clicked => { about-window.show(); }
            }

            about-window := PopupWindow {
                width: 500px;
                height: 200px;
                x: -300px;
                close-policy: no-auto-close;

                Rectangle {
                    height: 100%;
                    width: 100%;
                    background: white;
                    border-color: #ccc;
                    border-width: 1px;

                    drop-shadow-color: black;
                    drop-shadow-offset-x: 0px;
                    drop-shadow-offset-y: 2px;
                    drop-shadow-blur: 4px;
                }

                VerticalLayout {
                    padding: 16px;

                    Text {
                        font-size: 20px;
                        text: "About Program";
                        font-weight: 700;
                        color: #333;
                    }

                    Text {
                        color: #333;
                        text: "LS paint: A FOSS MS paint clone.\n\n" +
                            "Github: [TODO github link]\n\n" +
                            "-- LICENSE: --\n" +
                            "Copyright (C) 2024 Bowserinator\n" +
                            "\n" +
                            "This program is free software: you can redistribute it and/or modify\n" +
                            "it under the terms of the GNU General Public License as published by\n" +
                            "the Free Software Foundation, either version 3 of the License, or\n" +
                            "(at your option) any later version.\n" +
                            "\n" +
                            "This program is distributed in the hope that it will be useful,\n" +
                            "but WITHOUT ANY WARRANTY; without even the implied warranty of\n" +
                            "MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n" +
                            "GNU General Public License for more details.\n" +
                            "\n" +
                            "You should have received a copy of the GNU General Public License\n" +
                            "along with this program. If not, see <https://www.gnu.org/licenses/>.\n";
                    }
                    AboutSlint {}

                    StandardButton {
                        kind: ok;
                        clicked => { about-window.close(); }
                    }
                }
            }
        }

    }

}
