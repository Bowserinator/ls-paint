import { Bar, BarDivider, BarItemGroup } from "bar.slint";
import { ImageButtonVertical, ImageButtonHorizontal, ImageButtonHorizontalDropdown, ImageButtonIcon, ImageButtonVerticalDropdown, ColorButtonVertical, ColorButton } from "../components/image-buttons.slint";
import { BarDropdown, BarDropdownItem, BarDropdownTitle, BarDropdownDivider, BarSizeDropdownItem } from "../components/bar-dropdown.slint";
import { Styles } from "../styles.slint";
import { UserState, DocumentState, ETool, ESelectionType, ERotation, ToolOptions, EShapeTexture, ShapeStyle, ShapeGallery, BrushGallery } from "../globals.slint";

// One cell of the Brushes picker: the picture of one brush type, outlined while
// it is the type in use.
component BrushGlyphButton inherits Rectangle {
    in property <image> source;
    in property <bool> focused: false;
    callback clicked;

    width: Styles.bar-brush-cell-size;
    height: Styles.bar-brush-cell-size;
    border-width: 1px;
    border-color: focused ? #8dbcec : touch.has-hover ? #c3ddf8 : Styles.bar-border-light;
    background: focused ? #c9e0f7 : touch.pressed ? #d5e6f7 : transparent;

    Image {
        x: 3px;
        y: 3px;
        width: root.width - 6px;
        height: root.height - 6px;
        source: root.source;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The Outline and Fill menus carry the same textures, so they share one
// component. The parent closes its popup when `picked` fires.
component TextureMenu inherits BarDropdown {
    in property <EShapeTexture> current;
    in property <bool> for-fill: false;
    in property <length> item-width: Styles.bar-dropdown-width;
    callback picked(EShapeTexture);

    BarDropdownItem {
        width: root.item-width;
        icon: root.for-fill ? @image-url("../../icons/textures/no-fill.png") : @image-url("../../icons/textures/no-outline.png");
        text: root.for-fill ? "No fill" : "No outline";
        focused: root.current == EShapeTexture.NONE;
        clicked => { root.picked(EShapeTexture.NONE); }
    }
    BarDropdownItem {
        width: root.item-width;
        icon: root.for-fill ? @image-url("../../icons/shape-fill.png") : @image-url("../../icons/shape-outline.png");
        text: "Solid color";
        focused: root.current == EShapeTexture.SOLID;
        clicked => { root.picked(EShapeTexture.SOLID); }
    }
    BarDropdownDivider { }
    BarDropdownItem {
        width: root.item-width;
        icon: @image-url("../../icons/textures/crayon.png");
        text: "Crayon";
        focused: root.current == EShapeTexture.CRAYON;
        clicked => { root.picked(EShapeTexture.CRAYON); }
    }
    BarDropdownItem {
        width: root.item-width;
        icon: @image-url("../../icons/textures/marker.png");
        text: "Marker";
        focused: root.current == EShapeTexture.MARKER;
        clicked => { root.picked(EShapeTexture.MARKER); }
    }
    BarDropdownItem {
        width: root.item-width;
        icon: @image-url("../../icons/textures/oil.png");
        text: "Oil";
        focused: root.current == EShapeTexture.OIL;
        clicked => { root.picked(EShapeTexture.OIL); }
    }
    BarDropdownItem {
        width: root.item-width;
        icon: @image-url("../../icons/textures/natural-pencil.png");
        text: "Natural pencil";
        focused: root.current == EShapeTexture.NATURAL_PENCIL;
        clicked => { root.picked(EShapeTexture.NATURAL_PENCIL); }
    }
    BarDropdownItem {
        width: root.item-width;
        icon: @image-url("../../icons/textures/watercolor.png");
        text: "Watercolor";
        focused: root.current == EShapeTexture.WATERCOLOR;
        clicked => { root.picked(EShapeTexture.WATERCOLOR); }
    }
}

component ShapeGlyphButton inherits Rectangle {
    in property <string> commands;
    in property <bool> focused: false;
    in property <bool> filled: true;
    callback clicked;

    width: Styles.bar-small-icon-size + 6px;
    height: Styles.bar-small-icon-size + 6px;
    border-width: 1px;
    border-color: focused ? Styles.shape-glyph-outline : touch.has-hover ? #c3ddf8 : transparent;
    background: focused ? #eaf3fd : touch.pressed ? #d5e6f7 : transparent;

    Path {
        x: 3px;
        y: 3px;
        width: root.width - 6px;
        height: root.height - 6px;
        viewbox-width: 26.0;
        viewbox-height: 26.0;
        commands: root.commands;
        fill: root.filled
            ? (root.focused ? Styles.shape-glyph-selected-fill : Styles.shape-glyph-fill)
            : transparent;
        stroke: Styles.shape-glyph-outline;
        stroke-width: 1px;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component HomeBar inherits Bar {
    // Groups merge into a single button as the ribbon narrows. A group collapses
    // once the ribbon can no longer hold it together with every group that does not
    // collapse before it, so the ribbon never runs out of room and no group keeps
    // less than the width its contents need.
    //
    // A new HomeBar has to know the strip width on its first layout pass, so the
    // conditions below read the width directly. A tab switch builds the bar again
    // and no resize follows, so a value that arrives later leaves the bar collapsed.
    private property <length> strip-width: root.width;
    // Which page the merged Shapes picker shows: 0 the shape gallery,
    // 1 the outline list, 2 the fill list.
    private property <int> picker-page: 0;

    // The Tools group owns these tools; the Brushes group owns the brush.
    private property <bool> tools-active: UserState.selected-tool == ETool.PENCIL
        || UserState.selected-tool == ETool.FILL
        || UserState.selected-tool == ETool.TEXT
        || UserState.selected-tool == ETool.ERASER
        || UserState.selected-tool == ETool.DROPPER
        || UserState.selected-tool == ETool.MAGNIFY;

    // The groups give way in a fixed order, which is not the order they sit in:
    // the Shapes group merges first, then the Clipboard and Image groups together,
    // then the Tools group and last the Colors group, so the palette stays up for
    // as long as the ribbon can hold it. The Brushes and Size groups never merge.
    // A group merges once the ribbon is narrower than the whole ribbon would be
    // with every group that merges before it already merged and every group from
    // it on showing its full content, so no group is ever squeezed and the ribbon
    // never runs out of room. To change the order, change which width-* each
    // condition reads as decided and which as full; nothing else depends on it.
    //
    // Each condition reads only the width-* properties of the groups that merge
    // before its own, which are already decided, and constants for the rest.
    // About goes before all of them: it shows only while the whole ribbon fits
    // expanded. Reading constants only keeps that out of the dependency chain.
    private property <bool> about-fits:
        root.strip-width >= full-width + Styles.ribbon-width-about + Styles.ribbon-overflow-margin;
    // What the About group costs the ribbon while it is showing.
    private property <length> effective-about:
        root.about-fits ? Styles.ribbon-width-about + Styles.ribbon-divider : 0px;
    // The seven groups before About, each with the divider after it, all expanded.
    private property <length> full-width:
        Styles.ribbon-width-clipboard + Styles.ribbon-width-image
            + Styles.ribbon-width-tools + Styles.ribbon-width-brushes
            + Styles.ribbon-width-shapes + Styles.ribbon-width-size
            + Styles.ribbon-width-colors + 7 * Styles.ribbon-divider;

    // The shapes grid narrows before its group merges: it drops a column at a
    // time down to four, and once it needs more rows than the ribbon band shows,
    // a column of scroll buttons beside it keeps every shape reachable.
    function grid-rows(columns: int) -> int {
        return (ShapeGallery.items.length + columns - 1) / columns;
    }
    function shapes-grid-width(columns: int) -> length {
        return columns * Styles.ribbon-shape-cell
            + (root.grid-rows(columns) > Styles.ribbon-shape-visible-rows
                ? Styles.ribbon-shape-scrollbar
                : 0px);
    }
    // The grid plus the Outline and Fill buttons the group draws beside it.
    function shapes-width(columns: int) -> length {
        return root.shapes-grid-width(columns) + Styles.ribbon-shapes-options;
    }
    // The rows the whole grid needs at the current column count, and how far it
    // can be scrolled a row at a time.
    private property <int> shape-rows: root.grid-rows(root.shape-columns);
    private property <bool> shapes-scrolls: root.shape-rows > Styles.ribbon-shape-visible-rows;
    private property <int> shape-scroll-max:
        max(0, root.shape-rows - Styles.ribbon-shape-visible-rows);
    private property <int> shape-scroll-row: 0;
    changed shape-columns => {
        root.shape-scroll-row = min(root.shape-scroll-row, root.shape-scroll-max);
    }
    // The ribbon the Shapes group can have before the groups after it are
    // squeezed, with every other group still showing its full content.
    private property <length> shapes-room:
        root.strip-width - (full-width - Styles.ribbon-width-shapes) - effective-about
            - Styles.ribbon-overflow-margin;
    private property <int> shape-columns:
        root.shapes-room >= root.shapes-width(8) ? 8
            : root.shapes-room >= root.shapes-width(7) ? 7
            : root.shapes-room >= root.shapes-width(6) ? 6
            : root.shapes-room >= root.shapes-width(5) ? 5
            : 4;

    // 1. Shapes: it can no longer show four columns, so the group merges.
    private property <bool> collapsed-shapes:
        root.strip-width < full-width - Styles.ribbon-width-shapes + root.shapes-width(4)
            + effective-about + Styles.ribbon-overflow-margin;
    private property <length> width-shapes:
        collapsed-shapes ? Styles.ribbon-merged-width : root.shapes-width(root.shape-columns);

    // 2. Clipboard and Image, together: the grid is at its narrowest, so they
    // give back their room before the Shapes group has to merge.
    private property <bool> collapsed-clipboard: root.shape-columns <= 4;
    // The Clipboard caption is the longest of the merged group names.
    private property <length> width-clipboard:
        collapsed-clipboard ? Styles.ribbon-merged-width + 12px : Styles.ribbon-width-clipboard;
    private property <bool> collapsed-image: collapsed-clipboard;
    private property <length> width-image:
        collapsed-image ? Styles.ribbon-merged-width : Styles.ribbon-width-image;

    // 3. Tools: the ribbon with those three merged no longer fits.
    private property <bool> collapsed-tools:
        root.strip-width < width-clipboard + width-image + Styles.ribbon-width-tools
            + Styles.ribbon-width-brushes + width-shapes + Styles.ribbon-width-size
            + Styles.ribbon-width-colors + 7 * Styles.ribbon-divider + effective-about
            + Styles.ribbon-overflow-margin;
    private property <length> width-tools:
        collapsed-tools ? Styles.ribbon-merged-width : Styles.ribbon-width-tools;

    // 4. Colors: the ribbon with those four merged no longer fits.
    private property <bool> collapsed-colors:
        root.strip-width < width-clipboard + width-image + width-tools
            + Styles.ribbon-width-brushes + width-shapes + Styles.ribbon-width-size
            + Styles.ribbon-width-colors + 7 * Styles.ribbon-divider + effective-about
            + Styles.ribbon-overflow-margin;
    private property <length> width-colors:
        collapsed-colors ? Styles.ribbon-merged-width : Styles.ribbon-width-colors;

    HorizontalLayout {
        grp-clipboard := BarItemGroup {
            title: "Clipboard";
            show-title: !collapsed-clipboard;

            clipboard-dropdown := PopupWindow {
                y: Styles.bar-dropdown-y;
                x: clipboard-dropdown-btn.x + Styles.ribbon-group-padding;

                BarDropdown {
                    BarDropdownItem {
                        icon: @image-url("../../icons/paste.png"); text: "Paste";
                        enabled: DocumentState.has-clipboard;
                        clicked => { UserState.paste-selection(); }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/paste.png"); text: "Paste from file";
                        clicked => { UserState.paste-from-file(); }
                    }
                    BarDropdownDivider {}
                    BarDropdownItem {
                        icon: @image-url("../../icons/cut.png"); text: "Cut";
                        enabled: DocumentState.has-selection;
                        clicked => { UserState.cut-selection(); }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/copy.png"); text: "Copy";
                        enabled: DocumentState.has-selection;
                        clicked => { UserState.copy-selection(); }
                    }
                }
            }

            HorizontalLayout {
                clipboard-dropdown-btn := ImageButtonVerticalDropdown {
                    focused1: clipboard-dropdown.is-open;
                    focused2: clipboard-dropdown.is-open;
                    // Merged, this button speaks for the whole group.
                    text: collapsed-clipboard ? "Clipboard" : "Paste";
                    icon: @image-url("../../icons/copy.png");
                    width: collapsed-clipboard ? Styles.ribbon-merged-width + 8px : Styles.bar-vertical-btn-width;

                    clicked => { UserState.paste-selection(); }
                    clicked_dropdown => { clipboard-dropdown.show(); }
                }

                // Taken out of the layout rather than hidden, so a merged group
                // is no wider than its button.
                if (!collapsed-clipboard) : VerticalLayout {
                    max-width: 64px;
                    spacing: Styles.bar-list-spacing;

                    ImageButtonHorizontal {
                        icon: @image-url("../../icons/cut.png");
                        text: "Cut";
                        enabled: DocumentState.has-selection;
                        clicked => { UserState.cut-selection(); }
                    }
                    ImageButtonHorizontal {
                        icon: @image-url("../../icons/copy.png");
                        text: "Copy";
                        enabled: DocumentState.has-selection;
                        clicked => { UserState.copy-selection(); }
                    }
                }
            }
        }
        BarDivider {}

        grp-image := BarItemGroup {
            title: "Image";
            show-title: !collapsed-image;

            rotate-dropdown := PopupWindow {
                y: Styles.bar-dropdown-y;
                x: rotate-btn.x;

                BarDropdown {
                    BarDropdownItem {
                        icon: @image-url("../../icons/rotate.png"); text: "Rotate 90° CW";
                        clicked => { UserState.rotate(ERotation.CW90); }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/rotate.png"); text: "Rotate 90° CCW";
                        clicked => { UserState.rotate(ERotation.CCW90); }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/rotate.png"); text: "Rotate 180°";
                        clicked => { UserState.rotate(ERotation.R180); }
                    }
                    BarDropdownDivider {}
                    BarDropdownItem {
                        icon: @image-url("../../icons/rotate.png"); text: "Flip horizontal";
                        clicked => { UserState.flip-horizontal(); }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/rotate.png"); text: "Flip vertical";
                        clicked => { UserState.flip-vertical(); }
                    }
                }
            }

            select-dropdown := PopupWindow {
                y: Styles.bar-dropdown-y;
                x: select-dropdown-btn.x + Styles.ribbon-group-padding;

                BarDropdown {
                    BarDropdownTitle { text: "Selection Shapes"; }
                    BarDropdownDivider {}
    
                    BarDropdownItem {
                        icon: @image-url("../../icons/selection.png"); text: "Rectangular selection";
                        focused: UserState.selection-type == ESelectionType.RECTANGULAR;
                        clicked => { UserState.select-shape(ESelectionType.RECTANGULAR); }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/free-selection.png"); text: "Free-hand selection";
                        focused: UserState.selection-type == ESelectionType.FREEHAND;
                        clicked => { UserState.select-shape(ESelectionType.FREEHAND); }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/selection.png"); text: "Polygon selection";
                        focused: UserState.selection-type == ESelectionType.POLYGON;
                        clicked => { UserState.select-shape(ESelectionType.POLYGON); }
                    }

                    BarDropdownDivider {}
                    BarDropdownTitle { text: "Selection Options"; }
                    BarDropdownDivider {}

                    BarDropdownItem {
                        icon: @image-url("../../icons/select-all.png"); text: "Select all";
                        clicked => { UserState.select-all(); }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/invert-selection.png"); text: "Invert selection";
                        clicked => { UserState.invert-selection(); }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/clear-selection.png"); text: "Clear selection";
                        clicked => { UserState.clear-selection(); }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/transparent-selection.png"); text: "Transparent selection";
                        clicked => { UserState.transparent-selection(); }
                    }
                }
            }

            image-menu := PopupWindow {
                y: Styles.bar-dropdown-y;
                x: image-merged.x;

                BarDropdown {
                    BarDropdownItem {
                        icon: @image-url("../../icons/select-all.png"); text: "Select all";
                        clicked => { UserState.select-all(); }
                    }
                    BarDropdownDivider {}
                    BarDropdownItem {
                        icon: @image-url("../../icons/crop.png"); text: "Crop";
                        enabled: DocumentState.has-selection;
                        clicked => { UserState.crop-to-selection(); }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/resize.png"); text: "Resize";
                        clicked => { UserState.resize-dialog(); }
                    }
                    BarDropdownDivider {}
                    BarDropdownItem {
                        icon: @image-url("../../icons/rotate.png"); text: "Rotate 90° CW";
                        clicked => { UserState.rotate(ERotation.CW90); }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/rotate.png"); text: "Rotate 90° CCW";
                        clicked => { UserState.rotate(ERotation.CCW90); }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/rotate.png"); text: "Rotate 180°";
                        clicked => { UserState.rotate(ERotation.R180); }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/rotate.png"); text: "Flip horizontal";
                        clicked => { UserState.flip-horizontal(); }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/rotate.png"); text: "Flip vertical";
                        clicked => { UserState.flip-vertical(); }
                    }
                }
            }

            image-merged := ImageButtonVerticalDropdown {
                visible: collapsed-image;
                focused1: image-menu.is-open || UserState.selected-tool == ETool.SELECTION;
                focused2: image-menu.is-open || UserState.selected-tool == ETool.SELECTION;
                // No width while the group is expanded: an invisible element
                // still holds its slot, which would squeeze the group's content.
                width: collapsed-image ? Styles.ribbon-merged-button : 0px;
                text: "Image";
                icon: @image-url("../../icons/resize.png");
                clicked => { image-menu.show(); }
                clicked_dropdown => { image-menu.show(); }
            }

            // Hidden content still holds its slot, which leaves a gap in a
            // merged group, so drop the width while collapsed.
            HorizontalLayout {
                visible: !collapsed-image;
                width: collapsed-image ? 0px : Styles.ribbon-width-image - 2 * Styles.ribbon-group-padding;
                select-dropdown-btn := ImageButtonVerticalDropdown {
                    text: "Select";
                    icon: 
                        UserState.selection-type == ESelectionType.RECTANGULAR ? @image-url("../../icons/selection.png") :
                        UserState.selection-type == ESelectionType.FREEHAND ? @image-url("../../icons/free-selection.png") :
                        @image-url("../../icons/selection.png");
                    focused1: UserState.selected-tool == ETool.SELECTION;
                    focused2: UserState.selected-tool == ETool.SELECTION;

                    clicked => { UserState.selected-tool = ETool.SELECTION; }
                    clicked_dropdown => {
                        select-dropdown.show();
                        UserState.selected-tool = ETool.SELECTION;
                    }
                }

                VerticalLayout {
                    max-width: 80px;
                    spacing: Styles.bar-list-spacing;

                    ImageButtonHorizontal {
                        text: "Crop";
                        icon: @image-url("../../icons/crop.png");
                        enabled: DocumentState.has-selection;
                        clicked => { UserState.crop-to-selection(); }
                    }
                    ImageButtonHorizontal {
                        text: "Resize";
                        icon: @image-url("../../icons/resize.png");
                        clicked => { UserState.resize-dialog(); }
                    }
                    rotate-btn := ImageButtonHorizontal {
                        text: "Rotate ▾";
                        icon: @image-url("../../icons/rotate.png");
                        clicked => { rotate-dropdown.show(); }
                    }
                }
            }
        }

        BarDivider {}

        grp-tools := BarItemGroup {
            title: "Tools";
            show-title: !collapsed-tools;

            tools-menu := PopupWindow {
                y: Styles.bar-dropdown-y;
                x: tools-merged.x;

                BarDropdown {
                    BarDropdownItem {
                        icon: @image-url("../../icons/pencil.png"); text: "Pencil";
                        focused: UserState.selected-tool == ETool.PENCIL;
                        clicked => { UserState.selected-tool = ETool.PENCIL; }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/paint.png"); text: "Fill with color";
                        focused: UserState.selected-tool == ETool.FILL;
                        clicked => { UserState.selected-tool = ETool.FILL; }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/text.png"); text: "Text";
                        focused: UserState.selected-tool == ETool.TEXT;
                        clicked => { UserState.selected-tool = ETool.TEXT; }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/eraser.png"); text: "Eraser";
                        focused: UserState.selected-tool == ETool.ERASER;
                        clicked => { UserState.selected-tool = ETool.ERASER; }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/colorpicker.png"); text: "Color picker";
                        focused: UserState.selected-tool == ETool.DROPPER;
                        clicked => { UserState.selected-tool = ETool.DROPPER; }
                    }
                    BarDropdownItem {
                        icon: @image-url("../../icons/magnify.png"); text: "Magnifier";
                        focused: UserState.selected-tool == ETool.MAGNIFY;
                        clicked => { UserState.selected-tool = ETool.MAGNIFY; }
                    }
                }
            }

            tools-merged := ImageButtonVerticalDropdown {
                visible: collapsed-tools;
                focused1: tools-menu.is-open || root.tools-active;
                focused2: tools-menu.is-open || root.tools-active;
                // No width while the group is expanded: an invisible element
                // still holds its slot, which would squeeze the group's content.
                width: collapsed-tools ? Styles.ribbon-merged-button : 0px;
                text: "Tools";
                icon: @image-url("../../icons/tools.png");
                clicked => { tools-menu.show(); }
                clicked_dropdown => { tools-menu.show(); }
            }

            GridLayout {
                visible: !collapsed-tools;
                width: collapsed-tools ? 0px : Styles.ribbon-width-tools - 2 * Styles.ribbon-group-padding;
                spacing: Styles.bar-padding;
                padding-top: Styles.bar-padding;

                Row {
                    ImageButtonIcon{
                        icon: @image-url("../../icons/pencil.png");
                        focused: UserState.selected-tool == ETool.PENCIL;
                        clicked => { UserState.selected-tool = ETool.PENCIL; }
                    }
                    ImageButtonIcon{
                        icon: @image-url("../../icons/paint.png");
                        focused: UserState.selected-tool == ETool.FILL;
                        clicked => { UserState.selected-tool = ETool.FILL; }
                    }
                    ImageButtonIcon{
                        icon: @image-url("../../icons/text.png");
                        focused: UserState.selected-tool == ETool.TEXT;
                        clicked => { UserState.selected-tool = ETool.TEXT; }
                    }
                }
                Row {
                    ImageButtonIcon{
                        icon: @image-url("../../icons/eraser.png");
                        focused: UserState.selected-tool == ETool.ERASER;
                        clicked => { UserState.selected-tool = ETool.ERASER; }

                    }
                    ImageButtonIcon{
                        icon: @image-url("../../icons/colorpicker.png");
                        focused: UserState.selected-tool == ETool.DROPPER;
                        clicked => { UserState.selected-tool = ETool.DROPPER; }
                    }
                    ImageButtonIcon{
                        icon: @image-url("../../icons/magnify.png");
                        focused: UserState.selected-tool == ETool.MAGNIFY;
                        clicked => { UserState.selected-tool = ETool.MAGNIFY; }
                    }
                }
            }
        }

        BarDivider {}

        grp-brushes := BarItemGroup {
            title: "";
            brushes-btn := ImageButtonVerticalDropdown {
                // "Brushes" is the longest group name, so its button is wider
                // than the other merged buttons.
                width: Styles.ribbon-merged-button + 8px;
                text: "Brushes";
                icon: @image-url("../../icons/brushes.png");
                focused1: brushes-dropdown.is-open || UserState.selected-tool == ETool.BRUSH;
                focused2: brushes-dropdown.is-open || UserState.selected-tool == ETool.BRUSH;
                clicked => { brushes-dropdown.show(); }
                clicked_dropdown => { brushes-dropdown.show(); }
            }
        }

        brushes-dropdown := PopupWindow {
            // Declared at the ribbon level, so the button's position inside its
            // group needs the group's own offset added.
            y: Styles.bar-dropdown-y;
            x: grp-brushes.x + brushes-btn.x;

            BarDropdown {
                // Narrower than the default panel: the tips sit in four columns.
                panel-width: 2px + 6px + 4 * Styles.bar-brush-cell-size + 6px;

                HorizontalLayout {
                    padding: 6px;

                    Rectangle {
                        width: 4 * Styles.bar-brush-cell-size;
                        height: 3 * Styles.bar-brush-cell-size;

                        for glyph[i] in BrushGallery.items: BrushGlyphButton {
                            x: mod(i, 4) * Styles.bar-brush-cell-size;
                            y: floor(i / 4) * Styles.bar-brush-cell-size;
                            source: glyph.image;
                            focused: ToolOptions.brush-kind == glyph.kind;
                            clicked => {
                                ToolOptions.brush-kind = glyph.kind;
                                UserState.selected-tool = ETool.BRUSH;
                                brushes-dropdown.close();
                            }
                        }
                    }
                }
            }
        }

        BarDivider {}

        grp-shapes := BarItemGroup {
            title: "Shapes";
            // The merged button carries the group name already.
            show-title: !collapsed-shapes;

            shape-gallery-dropdown := PopupWindow {
                y: Styles.bar-dropdown-y;
                x: collapsed-shapes ? shape-merged.x : shape-box.x;

                BarDropdown {
                    panel-width: Styles.bar-shapes-menu-width;

                    if (root.picker-page == 0) : HorizontalLayout {
                        padding: 6px;
                        spacing: 6px;

                        Rectangle {
                            width: 7 * (Styles.bar-small-icon-size + 6px);
                            height: 4 * (Styles.bar-small-icon-size + 6px);

                            for glyph[i] in ShapeGallery.items: ShapeGlyphButton {
                                x: mod(i, 7) * (Styles.bar-small-icon-size + 6px);
                                y: floor(i / 7) * (Styles.bar-small-icon-size + 6px);
                                commands: glyph.commands;
                                focused: ShapeStyle.kind == glyph.kind;
                                filled: glyph.filled;
                                clicked => {
                                    ShapeStyle.kind = glyph.kind;
                                    UserState.selected-tool = ETool.SHAPE;
                                    shape-gallery-dropdown.close();
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: start;

                            // Merged away, the outline and fill buttons have no home
                            // of their own, so the picker carries them. Clicking one
                            // turns the picker over to that part's list.
                            shape-outline-btn := ImageButtonVerticalDropdown {
                                width: Styles.bar-shape-mode-btn-width;
                                text: "Outline";
                                icon: @image-url("../../icons/shape-outline.png");
                                focused1: ShapeStyle.outline != EShapeTexture.NONE;
                                focused2: ShapeStyle.outline != EShapeTexture.NONE;
                                clicked => {
                                    root.picker-page = 1;
                                    shape-gallery-dropdown.show();
                                }
                                clicked_dropdown => {
                                    root.picker-page = 1;
                                    shape-gallery-dropdown.show();
                                }
                            }
                            shape-fill-btn := ImageButtonVerticalDropdown {
                                width: Styles.bar-shape-mode-btn-width;
                                text: "Fill";
                                icon: @image-url("../../icons/shape-fill.png");
                                focused1: ShapeStyle.fill != EShapeTexture.NONE;
                                focused2: ShapeStyle.fill != EShapeTexture.NONE;
                                clicked => {
                                    root.picker-page = 2;
                                    shape-gallery-dropdown.show();
                                }
                                clicked_dropdown => {
                                    root.picker-page = 2;
                                    shape-gallery-dropdown.show();
                                }
                            }
                        }
                    }

                    if (root.picker-page == 1) : TextureMenu {
                        panel-width: Styles.bar-shapes-menu-width;
                        item-width: Styles.bar-shapes-menu-width - 2px;
                        current: ShapeStyle.outline;
                        picked(texture) => {
                            ShapeStyle.outline = texture;
                            root.picker-page = 0;
                            shape-gallery-dropdown.show();
                        }
                    }

                    if (root.picker-page == 2) : TextureMenu {
                        panel-width: Styles.bar-shapes-menu-width;
                        item-width: Styles.bar-shapes-menu-width - 2px;
                        for-fill: true;
                        current: ShapeStyle.fill;
                        picked(texture) => {
                            ShapeStyle.fill = texture;
                            root.picker-page = 0;
                            shape-gallery-dropdown.show();
                        }
                    }

                    Text {
                        width: Styles.bar-shapes-menu-width - 2px;
                        height: Styles.bar-dropdown-height;
                        text: "Shapes";
                        font-size: Styles.bar-font-size;
                        color: #646464;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            outline-dropdown := PopupWindow {
                y: modes.y + outline-btn.y + outline-btn.arrow-y + outline-btn.arrow-height + Styles.bar-dropdown-gap + 15px;
                x: modes.x + outline-btn.x;

                TextureMenu {
                    current: ShapeStyle.outline;
                    picked(texture) => {
                        ShapeStyle.outline = texture;
                        outline-dropdown.close();
                    }
                }
            }

            fill-dropdown := PopupWindow {
                y: modes.y + fill-btn.y + fill-btn.arrow-y + fill-btn.arrow-height + Styles.bar-dropdown-gap + 15px;
                x: modes.x + fill-btn.x;

                TextureMenu {
                    for-fill: true;
                    current: ShapeStyle.fill;
                    picked(texture) => {
                        ShapeStyle.fill = texture;
                        fill-dropdown.close();
                    }
                }
            }

            shape-merged := ImageButtonVerticalDropdown {
                visible: collapsed-shapes;
                // No width while the group is expanded: an invisible element
                // still holds its slot, which would squeeze the group's content.
                width: collapsed-shapes ? Styles.ribbon-merged-button : 0px;
                text: "Shapes";
                icon: @image-url("../../icons/shapes.png");
                focused1: UserState.selected-tool == ETool.SHAPE || shape-gallery-dropdown.is-open;
                focused2: UserState.selected-tool == ETool.SHAPE || shape-gallery-dropdown.is-open;
                clicked => {
                    UserState.selected-tool = ETool.SHAPE;
                    root.picker-page = 0;
                    shape-gallery-dropdown.show();
                }
                clicked_dropdown => {
                    UserState.selected-tool = ETool.SHAPE;
                    root.picker-page = 0;
                    shape-gallery-dropdown.show();
                }
            }

            Rectangle {
                visible: !collapsed-shapes;
                width: collapsed-shapes ? 0px : root.shapes-grid-width(root.shape-columns);
                height: Styles.ribbon-shape-visible-rows * Styles.ribbon-shape-cell;

                // The shape box: every kind the tool offers, laid out in as many
                // rows as the columns need, three of them on show at a time.
                shape-box := Rectangle {
                    x: 0px;
                    y: 0px;
                    width: root.shape-columns * Styles.ribbon-shape-cell;
                    height: Styles.ribbon-shape-visible-rows * Styles.ribbon-shape-cell;
                    clip: true;

                    for glyph[i] in ShapeGallery.items: ShapeGlyphButton {
                        x: mod(i, root.shape-columns) * Styles.ribbon-shape-cell;
                        y: (floor(i / root.shape-columns) - root.shape-scroll-row) * Styles.ribbon-shape-cell;
                        // Only the rows on show take clicks; the rest are clipped.
                        visible: floor(i / root.shape-columns) >= root.shape-scroll-row
                            && floor(i / root.shape-columns) < root.shape-scroll-row + Styles.ribbon-shape-visible-rows;
                        commands: glyph.commands;
                        focused: ShapeStyle.kind == glyph.kind;
                        clicked => {
                            ShapeStyle.kind = glyph.kind;
                            UserState.selected-tool = ETool.SHAPE;
                        }
                    }
                }

                // The scroll column: an arrow per row, and a bar that shows which
                // three rows of the grid are on show.
                VerticalLayout {
                    x: shape-box.width;
                    y: 0px;
                    // Only the rows the band cannot show need reaching.
                    visible: root.shapes-scrolls;
                    width: root.shapes-scrolls ? Styles.ribbon-shape-scrollbar : 0px;
                    height: 100%;
                    spacing: 0px;

                    Rectangle {
                        width: 100%;
                        height: Styles.ribbon-shape-scrollbar;
                        background: #f5f6f7;
                        border-width: 1px;
                        border-color: Styles.bar-border-light;

                        Path {
                            x: 3px;
                            y: 3px;
                            width: parent.width - 6px;
                            height: parent.height - 6px;
                            viewbox-width: 1.0;
                            viewbox-height: 1.0;
                            commands: "M 0.5 0.05 L 0.95 0.75 L 0.05 0.75 Z";
                            fill: root.shape-scroll-row > 0 ? Styles.bar-text-color : #b8b8b8;
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.shape-scroll-row = max(0, root.shape-scroll-row - 1);
                            }
                        }
                    }

                    Rectangle {
                        width: 100%;
                        height: parent.height - 2 * Styles.ribbon-shape-scrollbar;
                        background: #ffffff;
                        border-width: 1px;
                        border-color: Styles.bar-border-light;

                        shape-thumb := Rectangle {
                            visible: root.shapes-scrolls;
                            x: 1px;
                            width: parent.width - 2px;
                            height: max(Styles.ribbon-shape-cell - 10px,
                                parent.height * Styles.ribbon-shape-visible-rows / max(1, root.shape-rows));
                            y: root.shape-scroll-max > 0
                                ? (parent.height - self.height) * root.shape-scroll-row / root.shape-scroll-max
                                : 0px;
                            background: #c3c3c3;
                        }

                        // A click or a drag anywhere on the bar puts the window of
                        // rows where the pointer is, which is the thumb's own drag.
                        TouchArea {
                            mouse-cursor: pointer;
                            pointer-event(e) => {
                                if (root.shape-scroll-max > 0
                                        && (e.kind == PointerEventKind.down
                                            || (e.kind == PointerEventKind.move && self.pressed))) {
                                    root.shape-scroll-row = max(0, min(root.shape-scroll-max,
                                        round((self.mouse-y - shape-thumb.height / 2)
                                            / (parent.height - shape-thumb.height)
                                            * root.shape-scroll-max)));
                                }
                            }
                        }
                    }

                    Rectangle {
                        width: 100%;
                        height: Styles.ribbon-shape-scrollbar;
                        background: #f5f6f7;
                        border-width: 1px;
                        border-color: Styles.bar-border-light;

                        Path {
                            x: 3px;
                            y: 3px;
                            width: parent.width - 6px;
                            height: parent.height - 6px;
                            viewbox-width: 1.0;
                            viewbox-height: 1.0;
                            commands: "M 0.05 0.25 L 0.95 0.25 L 0.5 0.95 Z";
                            fill: root.shape-scroll-row < root.shape-scroll-max ? Styles.bar-text-color : #b8b8b8;
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.shape-scroll-row = min(root.shape-scroll-max, root.shape-scroll-row + 1);
                            }
                        }
                    }
                }
            }

            // The outline and fill choices are part of the expanded group only;
            // the merged button carries them inside the gallery popup.
            modes := VerticalLayout {
                visible: !collapsed-shapes;
                width: collapsed-shapes ? 0px : Styles.ribbon-shape-mode-width;
                // The pair sits at the top of the row, like the glyph grid
                // beside it, instead of floating in the middle of the bar.
                height: 100%;
                alignment: start;
                spacing: Styles.bar-list-spacing;

                outline-btn := ImageButtonHorizontalDropdown {
                    width: Styles.ribbon-shape-mode-width;
                    text: "Outline";
                    icon: @image-url("../../icons/shape-outline.png");
                    clicked => { outline-dropdown.show(); }
                }

                fill-btn := ImageButtonHorizontalDropdown {
                    width: Styles.ribbon-shape-mode-width;
                    text: "Fill";
                    icon: @image-url("../../icons/shape-fill.png");
                    clicked => { fill-dropdown.show(); }
                }
            }
        }

        BarDivider {}

        grp-size := BarItemGroup {
            title: "";

            size-dropdown := PopupWindow {
                y: Styles.bar-dropdown-y;
                x: size-dropdown-btn.x;

                BarDropdown {
                    BarSizeDropdownItem {
                        text: "1px"; size: 1px;
                        clicked => { ToolOptions.brush-size = self.size; ShapeStyle.thickness = 1; }
                    }
                    BarSizeDropdownItem {
                        text: "2px"; size: 2px;
                        clicked => { ToolOptions.brush-size = self.size; ShapeStyle.thickness = 2; }
                    }
                    BarSizeDropdownItem {
                        text: "3px"; size: 3px;
                        clicked => { ToolOptions.brush-size = self.size; ShapeStyle.thickness = 3; }
                    }
                    BarSizeDropdownItem {
                        text: "4px"; size: 4px;
                        clicked => { ToolOptions.brush-size = self.size; ShapeStyle.thickness = 4; }
                    }
                    BarSizeDropdownItem {
                        text: "5px"; size: 5px;
                        clicked => { ToolOptions.brush-size = self.size; ShapeStyle.thickness = 5; }
                    }
                    BarSizeDropdownItem {
                        text: "8px"; size: 8px;
                        clicked => { ToolOptions.brush-size = self.size; ShapeStyle.thickness = 8; }
                    }
                    BarSizeDropdownItem {
                        text: "10px"; size: 10px;
                        clicked => { ToolOptions.brush-size = self.size; ShapeStyle.thickness = 10; }
                    }
                }
            }

            size-dropdown-btn := ImageButtonVerticalDropdown {
                text: "Size";
                icon: @image-url("../../icons/size.png");
                focused1: size-dropdown.is-open;
                focused2: size-dropdown.is-open;

                clicked => {
                    size-dropdown.show();
                }
                clicked_dropdown => {
                    size-dropdown.show();
                }
            }
        }

        BarDivider {}

        grp-colors := BarItemGroup {
            title: "Colors";
            show-title: !collapsed-colors;
            width: collapsed-colors ? Styles.ribbon-merged-width : Styles.ribbon-width-colors;

            colors-menu := PopupWindow {
                y: Styles.bar-dropdown-y;
                // The widest panel in the ribbon: it stays under its button while
                // the bar has room and slides left to keep its right edge inside
                // the bar when the button sits near the end of a narrow window.
                x: grp-colors.x + colors-merged.x + Styles.bar-colors-menu-width
                        > root.width - Styles.bar-padding
                    ? root.width - Styles.bar-padding - Styles.bar-colors-menu-width - grp-colors.x
                    : colors-merged.x;

                BarDropdown {
                    panel-width: Styles.bar-colors-menu-width;

                    // The swatches sit beside the palette, as Paint draws them.
                    HorizontalLayout {
                        padding: 6px;
                        spacing: 6px;

                        ColorButtonVertical {
                            width: 50px;
                            colr: UserState.primary-color;
                            // Wrapped like Paint's, so the caption never elides.
                            text: "Color\n1";
                            focused: UserState.color_idx == 0;
                            clicked => { UserState.color_idx = 0; }
                        }
                        ColorButtonVertical {
                            width: 50px;
                            colr: UserState.secondary-color;
                            text: "Color\n2";
                            focused: UserState.color_idx == 1;
                            clicked => { UserState.color_idx = 1; }
                        }

                        Rectangle {
                            width: Styles.bar-color-cell * 10;
                            height: Styles.bar-color-cell * 4;

                            for color[i] in UserState.color_palette: ColorButton {
                                x: mod(i, 10) * Styles.bar-color-cell;
                                y: floor(i / 10) * Styles.bar-color-cell;
                                cell: Styles.bar-color-cell;
                                colr: color;
                                clicked => {
                                    if (UserState.color_idx == 0) {
                                        UserState.primary-color = color;
                                    } else {
                                        UserState.secondary-color = color;
                                    }
                                }
                            }
                        }

                        // Paint keeps the picker tile at the end of the palette row.
                        ImageButtonVertical {
                            width: Styles.bar-vertical-btn-width;
                            icon: @image-url("../../icons/edit-colors.png");
                            text: "Edit\ncolors";
                        }
                    }

                    Text {
                        width: Styles.bar-colors-menu-width - 2px;
                        height: Styles.bar-dropdown-height;
                        text: "Colors";
                        font-size: Styles.bar-font-size;
                        color: #646464;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            HorizontalLayout {
                // Wrapped in `if` and not hidden with `visible`: an invisible element
                // still holds its slot in the layout, so the group would not give the
                // space back when it collapses.
                if (!collapsed-colors) : HorizontalLayout {
                    ColorButtonVertical {
                        width: 50px;
                        colr: UserState.primary-color;
                        // Wrapped like Paint's, so the caption never elides.
                        text: "Color\n1";
                        focused: UserState.color_idx == 0;
                        clicked => { UserState.color_idx = 0; }
                    }
                    ColorButtonVertical {
                        width: 50px;
                        colr: UserState.secondary-color;
                        text: "Color\n2";
                        focused: UserState.color_idx == 1;
                        clicked => { UserState.color_idx = 1; }
                    }

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;

                        Rectangle {
                            width: Styles.bar-color-cell * 10;
                            height: Styles.bar-color-cell * 4;

                            for color[i] in UserState.color_palette:
                                ColorButton {
                                    x: mod(i, 10) * Styles.bar-color-cell;
                                    y: floor(i / 10) * Styles.bar-color-cell;
                                    cell: Styles.bar-color-cell;
                                    colr: color;
                                    clicked => {
                                        if (UserState.color_idx == 0) {
                                            UserState.primary-color = color;
                                        } else {
                                            UserState.secondary-color = color;
                                        }
                                    }
                                }
                        }
                    }

                    ImageButtonVertical {
                        width: 70px;
                        // Two lines, as Paint draws it, so the caption never elides.
                        text: "Edit\ncolors";
                        icon: @image-url("../../icons/edit-colors.png");
                        clicked => { UserState.edit-colors(); }
                    }

                    // A little air between the last button and the group's edge.
                    Rectangle {
                        width: 4px;
                        background: transparent;
                    }
                }

                colors-merged := ImageButtonVerticalDropdown {
                    visible: collapsed-colors;
                    focused1: colors-menu.is-open;
                    focused2: colors-menu.is-open;
                    width: collapsed-colors ? Styles.ribbon-merged-button : 0px;
                    text: "Colors";
                    icon: @image-url("../../icons/edit-colors.png");
                    clicked => { colors-menu.show(); }
                    clicked_dropdown => { colors-menu.show(); }
                }
            }
        }

        BarDivider {}

        grp-about := BarItemGroup {
            title: "";
            visible: about-fits;
            width: about-fits ? Styles.ribbon-width-about : 0px;
            ImageButtonVertical {
                width: 76px;
                icon: @image-url("../../icons/about.png");
                text: "About";

                clicked => { UserState.about(); }
            }

        }

    }

}
