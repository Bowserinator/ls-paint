import { ScrollView, Palette } from "std-widgets.slint";
import { TopBar } from "topbar.slint";
import { StatusBar } from "statusbar.slint";
import { Styles } from "styles.slint";
import { CanvasResizeHandle } from "components/canvas-resize-handle.slint";
import { CanvasMenuItem, CanvasMenuDivider, CanvasMenuFrame } from "components/canvas-menu.slint";
import { CanvasRuler } from "components/canvas-ruler.slint";
import { CanvasCursor } from "components/canvas-cursor.slint";

import { UserState, DocumentState, ETool, EContentTransform, ZoomScale, ShapeStyle, ShapeOverlay, FontStyle, TextOverlay, RotateOverlay, ResizeOverlay, EResizeCursor, ToolOptions, ViewArea } from "globals.slint";
export * from "globals.slint";

import "../assets/weblysleek/weblysleekuil.ttf";
import "../assets/weblysleek/weblysleekuisl.ttf";
import "../assets/weblysleek/weblysleekuisb.ttf";
import "../assets/weblysleek/weblysleekuili.ttf";
import "../assets/weblysleek/weblysleekuisli.ttf";
import "../assets/weblysleek/weblysleekuisbi.ttf";

// Which quadrant of the rotation centre the pointer is in, as seen on screen.
enum ERotateCorner { NE, NW, SE, SW }

// The badge shown at the pointer over the rotate zone: a curved arrow lying in
// the corner the pointer is in.
component RotateBadge inherits Rectangle {
    in property <ERotateCorner> corner: ERotateCorner.NE;
    width: 24px;
    height: 24px;

    Image {
        width: 24px;
        height: 24px;
        source: root.corner == ERotateCorner.NW ? @image-url("../icons/rotate/rotate-nw.png")
              : root.corner == ERotateCorner.SE ? @image-url("../icons/rotate/rotate-se.png")
              : root.corner == ERotateCorner.SW ? @image-url("../icons/rotate/rotate-sw.png")
              : @image-url("../icons/rotate/rotate-ne.png");
    }
}

// The badge shown at the pointer over a resize grip: a double arrow lying along
// the line the grip drags.
component ResizeBadge inherits Rectangle {
    in property <EResizeCursor> shape: EResizeCursor.HORIZONTAL;
    width: 24px;
    height: 24px;

    Image {
        width: 24px;
        height: 24px;
        source: root.shape == EResizeCursor.VERTICAL ? @image-url("../icons/resize/resize-vertical.png")
              : root.shape == EResizeCursor.NWSE ? @image-url("../icons/resize/resize-nwse.png")
              : root.shape == EResizeCursor.NESW ? @image-url("../icons/resize/resize-nesw.png")
              : @image-url("../icons/resize/resize-horizontal.png");
    }
}

// The frame the open text box wears: the run pattern the selection outline is
// made of, held still instead of crawling. Each run is one device pixel thick,
// so the frame stays one pixel thick at every zoom and on every screen.
component AntsFrame inherits Rectangle {
    // Device pixels per logical pixel.
    in property <float> device-ratio: 1.0;
    property <length> hair: 1px / root.device-ratio;
    property <length> run: max(1.0, round(3.0 * root.device-ratio)) * root.hair;

    for i in floor(root.width / root.run) : Rectangle {
        x: i * root.run;
        y: 0px;
        width: min(root.run, root.width - i * root.run);
        height: root.hair;
        background: mod(i, 2) == 0 ? Styles.ants-dark : Styles.ants-light;
    }
    for i in floor(root.width / root.run) : Rectangle {
        x: i * root.run;
        y: root.height - root.hair;
        width: min(root.run, root.width - i * root.run);
        height: root.hair;
        background: mod(i, 2) == 0 ? Styles.ants-dark : Styles.ants-light;
    }
    for i in floor(root.height / root.run) : Rectangle {
        x: 0px;
        y: i * root.run;
        width: root.hair;
        height: min(root.run, root.height - i * root.run);
        background: mod(i, 2) == 0 ? Styles.ants-dark : Styles.ants-light;
    }
    for i in floor(root.height / root.run) : Rectangle {
        x: root.width - root.hair;
        y: i * root.run;
        width: root.hair;
        height: min(root.run, root.height - i * root.run);
        background: mod(i, 2) == 0 ? Styles.ants-dark : Styles.ants-light;
    }
}

export component AppWindow inherits Window {
    // The canvas as a row-major grid of square images, `tile-size` document
    // pixels a side; the ones on the right and bottom edges are cut short.
    in property <[image]> tiles;
    in property <int> tile-size: 512;
    property <int> tile-columns: max(1, ceil(DocumentState.canvas-width / root.tile-size));

    // Pixels each tile image shows past its edge, in document pixels, and
    // whether the images are drawn as crisp blocks. Both come from the backend,
    // which makes the images.
    in property <float> tile-overlap: 2.0;
    in property <bool> tile-pixelated: true;
    in property <float> device-ratio: 1.0;

    // The zoom, reported so the backend can make the images that suit it.
    property <float> canvas-zoom: UserState.zoom;
    callback canvas-zoom-changed(float);

    // What the window shows of the document, so only the tiles near it are built.
    in-out property <ViewArea> view-area: {
        x: (-scroll.viewport-x - root.canvas-origin) / UserState.zoom / 1px,
        y: (-scroll.viewport-y - root.canvas-origin) / UserState.zoom / 1px,
        width: scroll.visible-width / UserState.zoom / 1px,
        height: scroll.visible-height / UserState.zoom / 1px,
    };
    callback view-area-changed(ViewArea);
    changed view-area => { root.view-area-changed(root.view-area); }

    // The brush or pencil that was in hand last, which Escape returns to when
    // it leaves the text tool.
    property <ETool> current-tool: UserState.selected-tool;
    property <ETool> last-brush-tool: ETool.PENCIL;
    changed current-tool => {
        if (root.current-tool == ETool.BRUSH || root.current-tool == ETool.PENCIL) {
            root.last-brush-tool = root.current-tool;
        }
    }
    changed canvas-zoom => { root.canvas-zoom-changed(root.canvas-zoom); }

    // Where a tile edge falls on screen. Edges sit on whole device pixels, the
    // same ones the backend cuts the tile images to, and each tile runs a little
    // under its neighbour, so no gap shows between the two; the paper's own edge
    // stays exact.
    pure function edge-x(doc: float) -> length {
        return (doc >= DocumentState.canvas-width ? DocumentState.canvas-width * UserState.zoom * root.device-ratio
            : round(doc * UserState.zoom * root.device-ratio)) / root.device-ratio * 1px;
    }
    pure function edge-y(doc: float) -> length {
        return (doc >= DocumentState.canvas-height ? DocumentState.canvas-height * UserState.zoom * root.device-ratio
            : round(doc * UserState.zoom * root.device-ratio)) / root.device-ratio * 1px;
    }

    // The nearest whole device pixel. Anything one device pixel thick that is
    // not on one would cover two of them, which draws it twice as heavy.
    pure function snap(value: length) -> length {
        return round(value / 1px * root.device-ratio) / root.device-ratio * 1px;
    }
    // One device pixel.
    property <length> hairline: 1px / root.device-ratio;
    // Side of a selection grip in device pixels.
    property <float> grip-size: max(3.0, round(7.0 * root.device-ratio / 1.7));
    // Moves a view offset to a whole device pixel. The tiles, the outline and
    // the grips all sit on the offset, so one that lands between pixels shifts
    // each of them by a different amount.
    function settled(offset: length, lowest: length) -> length {
        return min(0px, max(min(0px, lowest), root.snap(offset)));
    }

    // Where the canvas right click menu is asked to open.
    in-out property <length> menu-x: 0px;
    in-out property <length> menu-y: 0px;

    // Ctrl+Alt turns a drag into a brush size change: the size and the pointer
    // at the press, and the document point it landed on.
    property <bool> size-dragging: false;
    property <length> size-drag-start: 0px;
    property <length> size-drag-size: 0px;
    property <length> size-drag-doc-x: 0px;
    property <length> size-drag-doc-y: 0px;

    property <bool> zoom-armed: false;
    property <bool> zoom-dragging: false;
    property <bool> pan-held: false;
    property <bool> panning: false;
    property <length> pan-from-x;
    property <length> pan-from-y;
    property <length> pan-viewport-x;
    property <length> pan-viewport-y;
    property <bool> pan-cursor: root.pan-held || root.panning;
    property <float> zoom-drag-from: 1.0;
    property <length> zoom-drag-anchor-x: 0px;
    property <length> zoom-drag-anchor-y: 0px;

    property <length> canvas-origin: round(4.0 * root.device-ratio) / root.device-ratio * 1px;
    // Document size: canvas-w/h are what the screen shows at the current
    // zoom, doc-w/h the pixels the document actually owns.
    property <length> doc-w: DocumentState.canvas-width * 1px;
    property <length> doc-h: DocumentState.canvas-height * 1px;
    property <length> canvas-w: root.doc-w * UserState.zoom;
    property <length> canvas-h: root.doc-h * UserState.zoom;

    // The grid's step in document pixels: the smallest power of two that keeps
    // a gap of at least 8px on screen, which never leaves more than 16px.
    property <float> grid-spacing:
        UserState.zoom >= 4.0 ? 2.0
        : UserState.zoom >= 2.0 ? 4.0
        : UserState.zoom >= 1.0 ? 8.0
        : UserState.zoom >= 0.5 ? 16.0
        : UserState.zoom >= 0.25 ? 32.0
        : 64.0;
    // The grid lines that can be seen: first line and how many. A zoomed-in
    // view of a large paper would otherwise carry thousands of lines that are
    // far off screen.
    property <float> grid-first-col: max(0.0, floor(root.view-area.x / root.grid-spacing));
    property <float> grid-last-col: min(floor((root.doc-w - 1px) / (root.grid-spacing * 1px)),
        floor((root.view-area.x + root.view-area.width) / root.grid-spacing) + 1.0);
    property <float> grid-first-row: max(0.0, floor(root.view-area.y / root.grid-spacing));
    property <float> grid-last-row: min(floor((root.doc-h - 1px) / (root.grid-spacing * 1px)),
        floor((root.view-area.y + root.view-area.height) / root.grid-spacing) + 1.0);
    property <length> resize-dx;
    property <length> resize-dy;

    // Window sizes
    min-height: 240px;
    min-width: 620px;

    preferred-height: 600px;
    preferred-width: 900px;

    // A dialog takes the keyboard while it is up; this hands it back when it
    // closes, because a control that goes away does not give focus back.
    public function focus-app() { focus-scope.focus(); }

    // Global styles
    default-font-family: "WeblySleek UI";
    title: (DocumentState.modified ? DocumentState.title + " *" : DocumentState.title) + " - LS Paint";

    function resize-canvas(dx: length, dy: length) {
        // The grips report screen deltas; the document only grows by their
        // un-zoomed worth.
        UserState.canvas-resize(max(1px, root.doc-w + dx / UserState.zoom),
                                max(1px, root.doc-h + dy / UserState.zoom));
    }

    // Where every zoom change funnels through: clamp the scale to the ends
    // of the ladder and turn the view around (px, py), a point in the visible
    // view, so the document pixel under it stays put. The zoom changes first
    // because the new canvas size is what the viewport clamp has to respect.
    function set-zoom(target: float, px: length, py: length) {
        let z = clamp(target, ZoomScale.min-zoom, ZoomScale.max-zoom);
        // Only the paper scales; its margin does not.
        let paper-x = px - scroll.viewport-x - root.canvas-origin;
        let paper-y = py - scroll.viewport-y - root.canvas-origin;
        let shift = 1.0 - z / UserState.zoom;
        let next-x = scroll.viewport-x + paper-x * shift;
        let next-y = scroll.viewport-y + paper-y * shift;
        UserState.zoom = z;
        scroll.viewport-x = root.settled(next-x, scroll.visible-width - scroll.viewport-width);
        scroll.viewport-y = root.settled(next-y, scroll.visible-height - scroll.viewport-height);
    }

    // Ctrl+wheel zooms the view around the point under the cursor, whether the
    // pointer is on the paper or on the gray around it. The point handed in is
    // the cursor's place in the visible view, so it is the content coordinate
    // plus the scroll the viewport has taken.
    function apply-zoom(px: length, py: length, factor: float) {
        root.set-zoom(UserState.zoom * factor, px, py);
    }

    // The -/+ boxes on the status bar: one notch along the ladder at a
    // time, turning the view around the centre of what is on screen. From
    // between two notches the button heads for the next one outside the
    // current zoom, and at either end the clamp keeps the scale put.
    function step-zoom(dir: int) {
        let here = ZoomScale.pct-to-pos(UserState.zoom * 100);
        let next = dir < 0 ? ceil(here) - 1 : floor(here) + 1;
        root.set-zoom(ZoomScale.pos-to-pct(next) / 100,
                      scroll.visible-width / 2, scroll.visible-height / 2);
    }

    // Shared by the paper and the gray around it. With a zoom modifier held
    // the wheel zooms around (px, py), the point under the cursor, by an amount
    // that follows the travel: a wheel notch is 60px and scales the view by a
    // quarter, and a trackpad's small deltas add up to the same, smoothly. A
    // horizontal swipe zooms too. Without the modifier the wheel pans the view
    // directly: handing it to the ScrollView's Flickable instead would arm that
    // Flickable's 800ms scroll filter, which then swallows every wheel near the
    // same spot, so ctrl+wheel went dead right after a plain scroll.
    function handle-wheel(event: PointerScrollEvent, px: length, py: length) {
        if (event.modifiers.control || event.modifiers.meta) {
            let d = event.delta-y != 0px ? event.delta-y : event.delta-x;
            root.apply-zoom(px, py, pow(ZoomScale.step, clamp(d, -120px, 120px) / 60px));
        } else {
            let dx = event.modifiers.shift ? event.delta-y : event.delta-x;
            let dy = event.modifiers.shift ? event.delta-x : event.delta-y;
            scroll.viewport-x = root.settled(scroll.viewport-x + dx,
                                             scroll.visible-width - scroll.viewport-width);
            scroll.viewport-y = root.settled(scroll.viewport-y + dy,
                                             scroll.visible-height - scroll.viewport-height);
        }
    }

    function pan-start(px: length, py: length) {
        root.panning = true;
        root.pan-from-x = px;
        root.pan-from-y = py;
        root.pan-viewport-x = scroll.viewport-x;
        root.pan-viewport-y = scroll.viewport-y;
    }

    function pan-move(px: length, py: length) {
        scroll.viewport-x = root.settled(root.pan-viewport-x + px - root.pan-from-x,
                                         scroll.visible-width - scroll.viewport-width);
        scroll.viewport-y = root.settled(root.pan-viewport-y + py - root.pan-from-y,
                                         scroll.visible-height - scroll.viewport-height);
    }

    // Whether the window draws the pointer over the paper instead of the system.
    // The magnifier keeps the system pointer, and so does the text tool while
    // its box is open, because the box has a pointer of its own.
    property <bool> custom-cursor: UserState.selected-tool != ETool.MAGNIFY
        && !(UserState.selected-tool == ETool.TEXT && TextOverlay.visible);

    init => {
        // The chrome this program draws is light, so the stock widgets are held
        // to the light palette too: on a dark desktop they would otherwise draw
        // white text on our white dialogs.
        Palette.color-scheme = ColorScheme.light;
        focus-scope.focus();
    }

    focus-scope := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if (event.text == "\u{1b}" && UserState.selected-tool == ETool.TEXT) {
                UserState.selected-tool = root.last-brush-tool;
            }
            let typing = UserState.selected-tool == ETool.TEXT && TextOverlay.visible;
            let plain = !event.modifiers.control && !event.modifiers.meta && !event.modifiers.alt;
            if (event.text == " " && (event.modifiers.control || event.modifiers.meta)) {
                root.zoom-armed = true;
            } else if (plain && !typing && event.text == " ") {
                root.pan-held = true;
            } else if (plain && !typing && event.text == "e") {
                UserState.selected-tool = ETool.ERASER;
            } else if (plain && !typing && event.text == "p") {
                UserState.selected-tool = root.last-brush-tool;
            } else {
                UserState.key-pressed(event.text, event.modifiers.control || event.modifiers.meta,
                                      event.modifiers.shift, event.modifiers.alt);
            }
            accept
        }

        key-released(event) => {
            if (event.text == " ") {
                root.zoom-armed = false;
                root.pan-held = false;
            }
            accept
        }

        VerticalLayout {
            bar := TopBar{
                vertical-stretch: 0;
            }

            Rectangle {
                background: #c5cfdf;
                vertical-stretch: 1;
                min-height: 100px;

                // The rulers sit on the view's top and left edges and hold it
                // clear, so what shrinks while they show is the canvas. The top
                // strip runs the full width, which puts the document's zero one
                // strip in from its own start.
                if UserState.show-rulers : CanvasRuler {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: Styles.ruler-size;
                    doc-length: root.doc-w;
                    view-length: scroll.visible-width;
                    scroll-offset: scroll.viewport-x;
                    start-in: Styles.ruler-size;
                    show-pointer: UserState.cursor-on-canvas;
                    pointer: UserState.cursor-x;
                    show-selection: DocumentState.has-selection;
                    selection-start: DocumentState.selection-x;
                    selection-size: DocumentState.selection-width;
                }

                if UserState.show-rulers : CanvasRuler {
                    x: 0px;
                    y: Styles.ruler-size;
                    width: Styles.ruler-size;
                    height: parent.height - Styles.ruler-size;
                    vertical: true;
                    doc-length: root.doc-h;
                    view-length: scroll.visible-height;
                    scroll-offset: scroll.viewport-y;
                    show-pointer: UserState.cursor-on-canvas;
                    pointer: UserState.cursor-y;
                    show-selection: DocumentState.has-selection;
                    selection-start: DocumentState.selection-y;
                    selection-size: DocumentState.selection-height;
                }

                scroll := ScrollView {
                    x: UserState.show-rulers ? Styles.ruler-size : 0px;
                    y: UserState.show-rulers ? Styles.ruler-size : 0px;
                    width: parent.width - (UserState.show-rulers ? Styles.ruler-size : 0px);
                    height: parent.height - (UserState.show-rulers ? Styles.ruler-size : 0px);
                    viewport-width: corner-handle.x + corner-handle.width + root.canvas-origin;
                    viewport-height: corner-handle.y + corner-handle.height + root.canvas-origin;
                    // The scroll bars can leave the offset between pixels.
                    changed viewport-x => {
                        if (self.viewport-x != root.snap(self.viewport-x)) {
                            self.viewport-x = root.snap(self.viewport-x);
                        }
                    }
                    changed viewport-y => {
                        if (self.viewport-y != root.snap(self.viewport-y)) {
                            self.viewport-y = root.snap(self.viewport-y);
                        }
                    }

                    // Ctrl+wheel over the gray around the paper zooms too, around
                    // the cursor like it does over the paper. Hovering here
                    // means the cursor is off the paper, which the status
                    // bar's readout reflects.
                    workspace-touch := TouchArea {
                        x: 0px;
                        y: 0px;
                        width: max(scroll.visible-width, scroll.viewport-width);
                        height: max(scroll.visible-height, scroll.viewport-height);

                        mouse-cursor: root.pan-cursor
                            ? (root.panning ? MouseCursor.grabbing : MouseCursor.grab) : MouseCursor.default;

                        pointer-event(event) => {
                            UserState.cursor-on-canvas = false;
                            if (event.kind == PointerEventKind.down && root.pan-held) {
                                focus-scope.focus();
                                root.pan-start(workspace-touch.mouse-x + scroll.viewport-x,
                                               workspace-touch.mouse-y + scroll.viewport-y);
                            } else if (event.kind == PointerEventKind.move && root.panning) {
                                root.pan-move(workspace-touch.mouse-x + scroll.viewport-x,
                                              workspace-touch.mouse-y + scroll.viewport-y);
                            } else if (event.kind == PointerEventKind.up
                                || event.kind == PointerEventKind.cancel) {
                                root.panning = false;
                            }
                        }

                        scroll-event(event) => {
                            root.handle-wheel(event, workspace-touch.mouse-x + scroll.viewport-x,
                                              workspace-touch.mouse-y + scroll.viewport-y);
                            accept
                        }
                    }

                    // The selection tool owns the right-click menu. It is a
                    // plain popup because the TouchArea child grabs the press
                    // before a ContextMenuArea would ever see it.
                    Rectangle {
                        x: root.canvas-origin;
                        y: root.canvas-origin;
                        width: root.canvas-w;
                        height: root.canvas-h;
                        background: transparent;
                        drop-shadow-blur: 12px;
                        drop-shadow-offset-y: 4px;
                        drop-shadow-color: rgba(0, 0, 0, 0.28);

                        canvas-menu := PopupWindow {
                            x: root.menu-x;
                            y: root.menu-y;

                            CanvasMenuFrame {
                                VerticalLayout {
                                    padding: 1px;

                                    CanvasMenuItem {
                                        caption: @tr("Cut");
                                        icon: @image-url("../icons/cut.png");
                                        enabled: DocumentState.has-selection;
                                        activated => { canvas-menu.close(); UserState.cut-selection(); }
                                    }
                                    CanvasMenuItem {
                                        caption: @tr("Copy");
                                        icon: @image-url("../icons/copy.png");
                                        enabled: DocumentState.has-selection;
                                        activated => { canvas-menu.close(); UserState.copy-selection(); }
                                    }
                                    CanvasMenuItem {
                                        caption: @tr("Paste");
                                        icon: @image-url("../icons/paste.png");
                                        enabled: DocumentState.has-clipboard;
                                        activated => { canvas-menu.close(); UserState.paste-selection(); }
                                    }

                                    CanvasMenuDivider { }

                                    CanvasMenuItem {
                                        caption: @tr("Crop");
                                        icon: @image-url("../icons/crop.png");
                                        enabled: DocumentState.has-selection;
                                        activated => { canvas-menu.close(); UserState.crop-to-selection(); }
                                    }
                                    CanvasMenuItem {
                                        caption: @tr("Select all");
                                        icon: @image-url("../icons/select-all.png");
                                        activated => { canvas-menu.close(); UserState.select-all(); }
                                    }
                                    CanvasMenuItem {
                                        caption: @tr("Invert selection");
                                        icon: @image-url("../icons/invert-selection.png");
                                        enabled: DocumentState.has-selection;
                                        activated => { canvas-menu.close(); UserState.invert-selection(); }
                                    }
                                    CanvasMenuItem {
                                        caption: @tr("Delete");
                                        icon: @image-url("../icons/clear-selection.png");
                                        enabled: DocumentState.has-selection;
                                        activated => { canvas-menu.close(); UserState.delete-selection(); }
                                    }
                                    CanvasMenuItem {
                                        caption: @tr("Deselect");
                                        icon: @image-url("../icons/selection.png");
                                        enabled: DocumentState.has-selection;
                                        activated => { canvas-menu.close(); UserState.clear-selection(); }
                                    }

                                    CanvasMenuDivider { }

                                    CanvasMenuItem {
                                        caption: @tr("Rotate 90° right");
                                        icon: @image-url("../icons/rotate.png");
                                        enabled: DocumentState.has-selection;
                                        activated => { canvas-menu.close(); UserState.transform-selection-content(EContentTransform.ROTATE_CW90); }
                                    }
                                    CanvasMenuItem {
                                        caption: @tr("Rotate 90° left");
                                        icon: @image-url("../icons/rotate.png");
                                        enabled: DocumentState.has-selection;
                                        activated => { canvas-menu.close(); UserState.transform-selection-content(EContentTransform.ROTATE_CCW90); }
                                    }
                                    CanvasMenuItem {
                                        caption: @tr("Rotate 180°");
                                        icon: @image-url("../icons/rotate.png");
                                        enabled: DocumentState.has-selection;
                                        activated => { canvas-menu.close(); UserState.transform-selection-content(EContentTransform.ROTATE_180); }
                                    }

                                    CanvasMenuDivider { }

                                    CanvasMenuItem {
                                        caption: @tr("Flip horizontal");
                                        icon: @image-url("../icons/rotate.png");
                                        enabled: DocumentState.has-selection;
                                        activated => { canvas-menu.close(); UserState.transform-selection-content(EContentTransform.FLIP_HORIZONTAL); }
                                    }
                                    CanvasMenuItem {
                                        caption: @tr("Flip vertical");
                                        icon: @image-url("../icons/rotate.png");
                                        enabled: DocumentState.has-selection;
                                        activated => { canvas-menu.close(); UserState.transform-selection-content(EContentTransform.FLIP_VERTICAL); }
                                    }

                                    CanvasMenuDivider { }

                                    CanvasMenuItem {
                                        caption: @tr("Invert color");
                                        icon: @image-url("../icons/edit-colors.png");
                                        activated => { canvas-menu.close(); UserState.invert-selection-colors(); }
                                    }
                                    CanvasMenuItem {
                                        caption: @tr("Resize");
                                        icon: @image-url("../icons/resize.png");
                                        activated => { canvas-menu.close(); UserState.resize-dialog(); }
                                    }
                                }
                            }
                        }

                        touch := TouchArea {
                            width: 100%;
                            height: 100%;
                            // Over the rotate zone the arrow the window draws at
                            // the pointer takes the cursor's place, so the system
                            // one is turned off while it shows.
                            mouse-cursor: root.pan-cursor
                                ? (root.panning ? MouseCursor.grabbing : MouseCursor.grab)
                                : (RotateOverlay.hover || RotateOverlay.rotating
                                    || ResizeOverlay.cursor != EResizeCursor.NONE
                                    || root.custom-cursor) ? MouseCursor.none : MouseCursor.default;

                            pointer-event(event) => {
                                // Every hover or press over the paper pins
                                // the document pixel under the cursor for
                                // the status bar to read out.
                                UserState.cursor-on-canvas = true;
                                // A size drag holds the cursor on the point it
                                // started from, so the tip grows in place.
                                if (!root.size-dragging) {
                                    UserState.cursor-x = touch.mouse-x / UserState.zoom / 1px;
                                    UserState.cursor-y = touch.mouse-y / UserState.zoom / 1px;
                                }
                                if (event.kind == PointerEventKind.down) {
                                    focus-scope.focus();
                                    if (root.pan-held && !(event.modifiers.control || event.modifiers.meta)) {
                                        root.pan-start(touch.mouse-x + root.canvas-origin + scroll.viewport-x,
                                                       touch.mouse-y + root.canvas-origin + scroll.viewport-y);
                                    } else if (root.zoom-armed
                                        && (event.modifiers.control || event.modifiers.meta)) {
                                        root.zoom-dragging = true;
                                        root.zoom-drag-from = UserState.zoom;
                                        root.zoom-drag-anchor-x = touch.mouse-x + root.canvas-origin + scroll.viewport-x;
                                        root.zoom-drag-anchor-y = touch.mouse-y + root.canvas-origin + scroll.viewport-y;
                                    } else if ((event.modifiers.control || event.modifiers.meta)
                                        && event.modifiers.alt) {
                                        // Ctrl+Alt resizes the brush instead of
                                        // painting, so the press never reaches a
                                        // tool and never starts a stroke.
                                        root.size-dragging = true;
                                        root.size-drag-start = touch.mouse-x;
                                        root.size-drag-size = ToolOptions.brush-size;
                                        root.size-drag-doc-x = touch.mouse-x / UserState.zoom;
                                        root.size-drag-doc-y = touch.mouse-y / UserState.zoom;
                                    } else if (UserState.selected-tool == ETool.MAGNIFY) {
                                        // A view tool, not a document tool: the press
                                        // zooms around the click point and never reaches
                                        // the C++ registry, so no stroke can start and no
                                        // floating selection gets baked.
                                        root.apply-zoom(touch.mouse-x + root.canvas-origin + scroll.viewport-x,
                                                        touch.mouse-y + root.canvas-origin + scroll.viewport-y,
                                                        event.button == PointerEventButton.right
                                                            || event.modifiers.alt ? 1 / ZoomScale.step : ZoomScale.step);
                                    } else if (event.button == PointerEventButton.right
                                        && UserState.selected-tool == ETool.SELECTION) {
                                        // The menu takes over input from here on, so the press is
                                        // not handed to the tool: a half-finished stroke would
                                        // never see its button-up and would swallow the next click.
                                        root.menu-x = touch.mouse-x;
                                        root.menu-y = touch.mouse-y;
                                        canvas-menu.show();
                                    } else {
                                        UserState.pointer-down(touch.mouse-x / UserState.zoom,
                                                               touch.mouse-y / UserState.zoom,
                                                               event.button == PointerEventButton.right);
                                    }
                                } else if (event.kind == PointerEventKind.up) {
                                    if (root.panning) {
                                        root.panning = false;
                                    } else if (root.zoom-dragging) {
                                        root.zoom-dragging = false;
                                    } else if (root.size-dragging) {
                                        root.size-dragging = false;
                                    } else {
                                        UserState.pointer-up(touch.mouse-x / UserState.zoom,
                                                             touch.mouse-y / UserState.zoom,
                                                             event.button == PointerEventButton.right);
                                    }
                                } else if (event.kind == PointerEventKind.cancel) {
                                    // The toolkit took the pointer away: the gesture
                                    // cannot be finished, so it is abandoned.
                                    root.zoom-dragging = false;
                                    root.size-dragging = false;
                                    if (root.panning) {
                                        root.panning = false;
                                    } else {
                                        UserState.pointer-cancel();
                                    }
                                } else if (event.kind == PointerEventKind.move) {
                                    if (root.panning) {
                                        root.pan-move(touch.mouse-x + root.canvas-origin + scroll.viewport-x,
                                                      touch.mouse-y + root.canvas-origin + scroll.viewport-y);
                                    } else if (root.zoom-dragging) {
                                        // Scales by the same factor per pixel as the
                                        // wheel, so zooming in and out feels even. The
                                        // travel is the pointer's place in the view, as
                                        // the paper's own coordinates shift with the zoom.
                                        root.set-zoom(root.zoom-drag-from * pow(ZoomScale.step,
                                                          (touch.mouse-x + root.canvas-origin + scroll.viewport-x
                                                           - root.zoom-drag-anchor-x) / 60px),
                                                      root.zoom-drag-anchor-x, root.zoom-drag-anchor-y);
                                    } else if (root.size-dragging) {
                                        // The drag distance is measured on the
                                        // document, so zoomed out a drag grows
                                        // the brush faster and zoomed in slower.
                                        ToolOptions.brush-size = max(1px, root.size-drag-size
                                            + (touch.mouse-x - root.size-drag-start) / UserState.zoom);
                                        // The tip grows about the point the drag
                                        // started on, so the drag changes the size
                                        // alone and leaves the brush where it was.
                                        UserState.pointer-move(root.size-drag-doc-x,
                                                               root.size-drag-doc-y,
                                                               event.modifiers.shift);
                                    } else if (!root.pan-held) {
                                        // Every hover as well as every drag: the tools
                                        // follow the pointer and the status bar reads
                                        // the colour under it.
                                        UserState.pointer-move(touch.mouse-x / UserState.zoom,
                                                               touch.mouse-y / UserState.zoom,
                                                               event.modifiers.shift);
                                    }
                                }
                            }

                            // The wheel is always ours: zoom with a
                            // modifier, pan without, never left to the
                            // Flickable's scroll filter.
                            scroll-event(event) => {
                                root.handle-wheel(event, touch.mouse-x + root.canvas-origin + scroll.viewport-x,
                                                  touch.mouse-y + root.canvas-origin + scroll.viewport-y);
                                accept
                            }

                        canvas := Rectangle {
                            width: 100%;
                            height: 100%;

                            for tile[i] in root.tiles : Image {
                                image-rendering: root.tile-pixelated
                                    ? ImageRendering.pixelated
                                    : ImageRendering.smooth;
                                source: tile;
                                // A tile draws over the ones to its right and below
                                // it. Where the screen places a tile between two
                                // device pixels its first row and column come out
                                // wrong, and those lie under its neighbour's overlap.
                                z: -1.0;
                                x: root.edge-x(mod(i, root.tile-columns) * root.tile-size);
                                y: root.edge-y(floor(i / root.tile-columns) * root.tile-size);
                                width: root.edge-x((mod(i, root.tile-columns) + 1) * root.tile-size + root.tile-overlap)
                                    - root.edge-x(mod(i, root.tile-columns) * root.tile-size);
                                height: root.edge-y((floor(i / root.tile-columns) + 1) * root.tile-size + root.tile-overlap)
                                    - root.edge-y(floor(i / root.tile-columns) * root.tile-size);
                            }
                        }
                        }
                    }

                    // The grid: one line per step, over the paper and under
                    // everything that is drawn on top of it. The loop stops
                    // before the far edge, so no line lands outside the paper.
                    if UserState.show-gridlines : Rectangle {
                        x: root.canvas-origin;
                        y: root.canvas-origin;
                        width: root.canvas-w;
                        height: root.canvas-h;
                        background: transparent;
                        clip: true;

                        for i in max(0.0, root.grid-last-col - root.grid-first-col + 1.0) : Rectangle {
                            x: root.snap((root.grid-first-col + i) * root.grid-spacing * UserState.zoom * 1px);
                            width: root.hairline;
                            height: 100%;
                            background: Styles.canvas-grid-color;
                        }

                        for i in max(0.0, root.grid-last-row - root.grid-first-row + 1.0) : Rectangle {
                            y: root.snap((root.grid-first-row + i) * root.grid-spacing * UserState.zoom * 1px);
                            width: 100%;
                            height: root.hairline;
                            background: Styles.canvas-grid-color;
                        }
                    }

                    Rectangle {
                        x: root.canvas-origin;
                        y: root.canvas-origin;
                        width: max(1px, root.canvas-w + root.resize-dx);
                        height: max(1px, root.canvas-h + root.resize-dy);
                        border-width: 1px;
                        border-color: black;
                        visible: right-handle.active || bottom-handle.active || corner-handle.active;
                    }

                    // The shape being dragged, as the pixels the commit will
                    // paint, so preview and result agree at every zoom.
                    if ShapeOverlay.visible : Image {
                        source: ShapeOverlay.preview;
                        x: root.canvas-origin + ShapeOverlay.x * UserState.zoom * 1px;
                        y: root.canvas-origin + ShapeOverlay.y * UserState.zoom * 1px;
                        width: ShapeOverlay.preview.width * UserState.zoom * 1px;
                        height: ShapeOverlay.preview.height * UserState.zoom * 1px;
                        image-rendering: UserState.zoom >= 1
                            ? ImageRendering.pixelated
                            : ImageRendering.smooth;
                    }

                    // The text box being typed. It takes focus while it is open
                    // and only reaches the paper when it closes: on Escape, on a
                    // click elsewhere or when the tool is left. The glyphs shown
                    // are the pixels the commit will paint, drawn by the backend;
                    // the input underneath only takes the typing.
                    if TextOverlay.visible : Rectangle {
                        x: root.canvas-origin + root.snap(TextOverlay.x * UserState.zoom);
                        y: root.canvas-origin + root.snap(TextOverlay.y * UserState.zoom);
                        width: root.snap(max(24px, TextOverlay.box-width * UserState.zoom * 1px));
                        height: root.snap(max(1px, TextOverlay.box-height * UserState.zoom * 1px));
                        // The backend draws the text again whenever the text,
                        // the cursor or the way it is set changes.
                        private property <string> mark-text: TextOverlay.content;
                        private property <length> mark-size: FontStyle.size * FontStyle.preview-scale;
                        private property <string> mark-style: FontStyle.family
                            + (FontStyle.bold ? "b" : "-") + (FontStyle.italic ? "i" : "-")
                            + (FontStyle.underline ? "u" : "-") + (FontStyle.strike ? "s" : "-")
                            + (FontStyle.opaque-background ? "o" : "-");
                        private property <color> mark-background: UserState.secondary-color;
                        changed mark-text => { UserState.measure-text(mark-text); }
                        changed mark-size => { UserState.measure-text(TextOverlay.content); }
                        changed mark-style => { UserState.measure-text(TextOverlay.content); }
                        changed mark-background => { UserState.measure-text(TextOverlay.content); }
                        background: transparent;
                        // The frame is drawn as runs, so the solid border only
                        // holds the text one pixel clear of it.
                        border-width: root.hairline;
                        border-color: transparent;

                        Image {
                            source: TextOverlay.preview;
                            x: -TextOverlay.preview-margin * UserState.zoom * 1px;
                            y: -TextOverlay.preview-margin * UserState.zoom * 1px;
                            width: TextOverlay.preview.width * UserState.zoom * 1px;
                            height: TextOverlay.preview.height * UserState.zoom * 1px;
                            image-rendering: UserState.zoom >= 1
                                ? ImageRendering.pixelated
                                : ImageRendering.smooth;
                        }

                        text-field := TextInput {
                            width: 100%;
                            height: 100%;
                            text <=> TextOverlay.content;
                            // Invisible: the backend's image is what is seen.
                            color: transparent;
                            selection-foreground-color: transparent;
                            font-family: FontStyle.family;
                            // The raster measures a size as the face's ascent plus
                            // descent, so the input scales by the face's own ratio
                            // to take up the room the committed pixels do.
                            font-size: FontStyle.size * UserState.zoom * FontStyle.preview-scale;
                            font-italic: FontStyle.italic;
                            font-weight: FontStyle.bold ? 700 : 400;
                            wrap: no-wrap;
                            single-line: false;
                            vertical-alignment: top;
                            horizontal-alignment: left;
                            init => { self.focus(); }
                            changed cursor-position-byte-offset => {
                                TextOverlay.cursor = self.cursor-position-byte-offset;
                                UserState.measure-text(TextOverlay.content);
                            }
                            key-pressed(event) => {
                                if (event.text == "\u{1b}") {
                                    UserState.cancel-text();
                                    UserState.selected-tool = root.last-brush-tool;
                                    return accept;
                                }
                                return reject;
                            }
                        }

                        Rectangle {
                            visible: text-field.has-focus;
                            x: TextOverlay.caret-x * UserState.zoom * 1px;
                            y: TextOverlay.caret-y * UserState.zoom * 1px;
                            width: 1px;
                            height: TextOverlay.caret-height * UserState.zoom * 1px;
                            background: TextOverlay.color;
                        }

                        // Over the text, where the selection's own outline sits:
                        // on the box's edge, one pixel clear of the glyphs.
                        AntsFrame {
                            x: -root.hairline;
                            y: -root.hairline;
                            width: parent.width + 2 * root.hairline;
                            height: parent.height + 2 * root.hairline;
                            device-ratio: root.device-ratio;
                        }
                    }

                    // The outline of an active selection: alternating light and
                    // dark runs covering its border, rebuilt from C++ as the
                    // phase advances so the pattern crawls around it.
                    // Runs are laid out in device pixels, so the ants keep the
                    // same dash length and weight at every magnification and
                    // every screen scale, each covering whole pixels.
                    for dash in DocumentState.ants-light : Rectangle {
                        x: root.canvas-origin + dash.x / root.device-ratio * 1px;
                        y: root.canvas-origin + dash.y / root.device-ratio * 1px;
                        width: dash.w / root.device-ratio * 1px;
                        height: dash.h / root.device-ratio * 1px;
                        background: Styles.ants-light;
                    }

                    for dash in DocumentState.ants-dark : Rectangle {
                        x: root.canvas-origin + dash.x / root.device-ratio * 1px;
                        y: root.canvas-origin + dash.y / root.device-ratio * 1px;
                        width: dash.w / root.device-ratio * 1px;
                        height: dash.h / root.device-ratio * 1px;
                        background: Styles.ants-dark;
                    }

                    // Resize grips sit on the selection's border. They are pure
                    // visuals: the press is hit-tested by the selection tool
                    // through the canvas touch area, so an element here must
                    // not grab it. Their position follows the zoom but their
                    // size stays put: a grip is a control, not a marking.
                    for grip in DocumentState.grips : Rectangle {
                        x: root.canvas-origin + round(grip.x - root.grip-size / 2.0) / root.device-ratio * 1px;
                        y: root.canvas-origin + round(grip.y - root.grip-size / 2.0) / root.device-ratio * 1px;
                        width: root.grip-size / root.device-ratio * 1px;
                        height: root.grip-size / root.device-ratio * 1px;
                        background: white;
                        border-width: root.hairline;
                        border-color: black;
                    }

                    // The badge at the pointer, while it is over the rotate zone
                    // or turning the contents.
                    if UserState.selected-tool == ETool.SELECTION && UserState.cursor-on-canvas
                        && !root.pan-cursor
                        && (RotateOverlay.hover || RotateOverlay.rotating) : RotateBadge {
                        x: root.canvas-origin + UserState.cursor-x * UserState.zoom * 1px - 12px;
                        y: root.canvas-origin + UserState.cursor-y * UserState.zoom * 1px - 12px;
                        corner: UserState.cursor-x < DocumentState.selection-x + DocumentState.selection-width / 2.0
                            ? (UserState.cursor-y < DocumentState.selection-y + DocumentState.selection-height / 2.0
                                ? ERotateCorner.NW : ERotateCorner.SW)
                            : (UserState.cursor-y < DocumentState.selection-y + DocumentState.selection-height / 2.0
                                ? ERotateCorner.NE : ERotateCorner.SE);
                    }

                    // The badge at the pointer, while it is over a resize grip.
                    if UserState.selected-tool == ETool.SELECTION && UserState.cursor-on-canvas
                        && !root.pan-cursor
                        && ResizeOverlay.cursor != EResizeCursor.NONE : ResizeBadge {
                        x: root.canvas-origin + UserState.cursor-x * UserState.zoom * 1px - 12px;
                        y: root.canvas-origin + UserState.cursor-y * UserState.zoom * 1px - 12px;
                        shape: ResizeOverlay.cursor;
                    }

                    // The outline of the tip and the crosshair, over everything on
                    // the paper except the rotate badge's own pointer.
                    if UserState.cursor-on-canvas && root.custom-cursor && !root.pan-cursor
                        && ResizeOverlay.cursor == EResizeCursor.NONE
                        && !(UserState.selected-tool == ETool.SELECTION
                            && (RotateOverlay.hover || RotateOverlay.rotating)) : CanvasCursor {
                        x: 0px;
                        y: 0px;
                        origin: root.canvas-origin;
                        zoom: UserState.zoom;
                        cursor-x: UserState.cursor-x;
                        cursor-y: UserState.cursor-y;
                    }

                    right-handle := CanvasResizeHandle {
                        x: root.canvas-origin + root.canvas-w + 2px;
                        y: root.canvas-origin + (root.canvas-h - self.height) / 2;
                        affects-width: true;
                        cursor: MouseCursor.ew-resize;

                        dragged(dx, dy) => { root.resize-dx = dx; root.resize-dy = dy; }
                        released(dx, dy) => { root.resize-canvas(dx, dy); }
                    }

                    bottom-handle := CanvasResizeHandle {
                        x: root.canvas-origin + (root.canvas-w - self.width) / 2;
                        y: root.canvas-origin + root.canvas-h + 2px;
                        affects-height: true;
                        cursor: MouseCursor.ns-resize;

                        dragged(dx, dy) => { root.resize-dx = dx; root.resize-dy = dy; }
                        released(dx, dy) => { root.resize-canvas(dx, dy); }
                    }

                    corner-handle := CanvasResizeHandle {
                        x: root.canvas-origin + root.canvas-w + 2px;
                        y: root.canvas-origin + root.canvas-h + 2px;
                        affects-width: true;
                        affects-height: true;
                        cursor: MouseCursor.nwse-resize;

                        dragged(dx, dy) => { root.resize-dx = dx; root.resize-dy = dy; }
                        released(dx, dy) => { root.resize-canvas(dx, dy); }
                    }
                }
            }

            // The bottom strip: pointer position, selection size, paper size,
            // the colour under the pointer, a blank, and the zoom controls.
            // The View tab's Status Bar box holds it out of the layout when it
            // is clear, so the canvas takes the space back.
            if UserState.show-status-bar : StatusBar {
                vertical-stretch: 0;

                zoom-chosen(pct) => {
                    root.set-zoom(pct / 100,
                                  scroll.visible-width / 2, scroll.visible-height / 2);
                }

                zoom-step(dir) => { root.step-zoom(dir); }
            }
        }
    }
}
