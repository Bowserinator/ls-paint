import { UserState, DocumentState, ZoomScale } from "globals.slint";
import { Styles } from "styles.slint";

// A round -/+ button: a light gray disc with a dark sign, like Paint's.
component ZoomButton inherits Rectangle {
    in property <bool> plus: false;
    callback clicked;

    width: 20px;

    disc := Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        border-width: 1px;
        border-color: touch.has-hover ? #6f7377 : #8e9195;
        background: touch.pressed
            ? @linear-gradient(180deg, #d4d6d8 0%, #bfc2c5 100%)
            : @linear-gradient(180deg, #fcfcfc 0%, #d9dbdd 100%);

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 8px;
            height: 2px;
            background: #4d4d4d;
        }

        if root.plus : Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 2px;
            height: 8px;
            background: #4d4d4d;
        }
    }

    touch := TouchArea {
        mouse-cursor: default;
        clicked => { root.clicked(); }
    }
}

// The zoom track: a thin groove with a blue pointer on it, both centered in
// the row. The pointer sits on `value`, a position on the zoom ladder, and a
// press or drag picks the notch nearest the cursor.
component ZoomSlider inherits Rectangle {
    in property <float> value;
    // Fired with the percentage of the notch the pointer was moved to.
    callback chosen(pct: float);

    property <length> thumb-width: 11px;
    // Almost the full height of the strip: the pointer is the tall part of the
    // control, the groove under it only marks the track.
    property <length> thumb-height: 19px;
    property <length> groove-height: 4px;
    property <length> travel: root.width - root.thumb-width;

    function pick(x: length) {
        let pos = round(clamp((x - root.thumb-width / 2) / root.travel, 0.0, 1.0) * 10.0);
        if (abs(pos - root.value) > 0.001) {
            root.chosen(ZoomScale.pos-to-pct(pos));
        }
    }

    Rectangle {
        x: 0px;
        y: (parent.height - root.groove-height) / 2;
        width: parent.width;
        height: root.groove-height;
        background: #e6e9ea;
        border-width: 1px;
        border-color: #d6d6d6;
    }

    Path {
        x: root.travel * clamp(root.value / 10.0, 0.0, 1.0);
        y: (parent.height - root.thumb-height) / 2;
        width: root.thumb-width;
        height: root.thumb-height;
        viewbox-width: 11;
        viewbox-height: 19;
        commands: "M 0 0 L 11 0 L 11 14 L 5.5 19 L 0 14 Z";
        fill: #0078d7;
    }

    touch := TouchArea {
        mouse-cursor: default;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down
                || (event.kind == PointerEventKind.move && touch.pressed)) {
                root.pick(touch.mouse-x);
            }
        }
    }
}

// The glyph a reading wears. The box stretches with the row, so the picture
// lands against the middle of the cell however tall the cell is.
component StatusGlyph inherits Rectangle {
    in property <image> icon;

    width: Styles.status-icon-size;

    Image {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: Styles.status-icon-size;
        height: Styles.status-icon-size;
        source: root.icon;
    }
}

// The line that parts two readings.
component StatusDivider inherits Rectangle {
    width: 1px;
    background: #c8ccd2;
}

// The strip along the bottom, split like MS Paint's: where the pointer is,
// how big the selection is, how big the paper is, the colour under the pointer,
// a blank held for later, and the zoom controls on the right. Every cell is a
// sunken box.
export component StatusBar inherits Rectangle {
    background: #f0f0f0;
    vertical-stretch: 0;
    min-height: 26px;

    // Fired with the notch the slider was moved to.
    callback zoom-chosen(pct: float);
    // Fired by the -/+ boxes, one notch per click.
    callback zoom-step(dir: int);

    HorizontalLayout {
        padding: 3px;
        spacing: 0px;

        // Pointer position, in document pixels.
        Rectangle {
            horizontal-stretch: 0;
            min-width: 100px;
            background: #f7f8fa;

            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 4px;

                StatusGlyph { icon: @image-url("../icons/status/pointer.png"); }

                Text {
                    vertical-alignment: center;
                    horizontal-alignment: left;
                    font-size: Styles.bar-font-size;
                    color: Styles.bar-text-color;
                    text: UserState.cursor-on-canvas
                        ? floor(UserState.cursor-x) + ", " + floor(UserState.cursor-y)
                        : "";
                }
            }
        }

        StatusDivider {}

        // Selection size, empty without one.
        Rectangle {
            horizontal-stretch: 0;
            min-width: 100px;
            background: #f7f8fa;

            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 4px;

                StatusGlyph { icon: @image-url("../icons/status/selection.png"); }

                Text {
                    vertical-alignment: center;
                    horizontal-alignment: left;
                    font-size: Styles.bar-font-size;
                    color: Styles.bar-text-color;
                    text: DocumentState.has-selection
                        ? DocumentState.selection-width + " x " + DocumentState.selection-height
                        : "";
                }
            }
        }

        StatusDivider {}

        // Paper size.
        Rectangle {
            horizontal-stretch: 0;
            min-width: 100px;
            background: #f7f8fa;

            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 4px;

                StatusGlyph { icon: @image-url("../icons/status/canvas.png"); }

                Text {
                    vertical-alignment: center;
                    horizontal-alignment: left;
                    font-size: Styles.bar-font-size;
                    color: Styles.bar-text-color;
                    text: DocumentState.canvas-width + " x " + DocumentState.canvas-height;
                }
            }
        }

        StatusDivider {}

        // The colour under the pointer, blank while it is off the paper.
        Rectangle {
            horizontal-stretch: 1;
            background: #f7f8fa;

            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 4px;

                StatusGlyph { icon: @image-url("../icons/status/color.png"); }

                Text {
                    vertical-alignment: center;
                    horizontal-alignment: left;
                    overflow: elide;
                    font-size: Styles.bar-font-size;
                    color: Styles.bar-text-color;
                    text: UserState.cursor-on-canvas ? UserState.hover-color-text : "";
                }
            }
        }

        StatusDivider {}

        // A blank, kept for whatever the ribbon grows next.
        Rectangle {
            horizontal-stretch: 1;
            background: #f7f8fa;
        }

        StatusDivider {}

        // Zoom: the percentage, then -/+ around the slider. Drawn straight on
        // the strip, like Paint's, rather than in a box.
        Rectangle {
            horizontal-stretch: 0;
            min-width: 250px;

            HorizontalLayout {
                padding-left: 6px;
                padding-right: 4px;
                spacing: 6px;

                StatusGlyph { icon: @image-url("../icons/status/zoom.png"); }

                Text {
                    horizontal-stretch: 0;
                    min-width: 44px;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                    font-size: Styles.bar-font-size;
                    color: Styles.bar-text-color;
                    // 12.5 has the fraction the ladder keeps; every other
                    // notch is a whole percent.
                    text: UserState.zoom * 100 == 12.5
                        ? "12.5%"
                        : round(UserState.zoom * 100) + "%";
                }

                ZoomButton {
                    horizontal-stretch: 0;
                    clicked => { root.zoom-step(-1); }
                }

                ZoomSlider {
                    horizontal-stretch: 1;
                    min-width: 80px;
                    value: ZoomScale.pct-to-pos(UserState.zoom * 100);
                    chosen(pct) => { root.zoom-chosen(pct); }
                }

                ZoomButton {
                    horizontal-stretch: 0;
                    plus: true;
                    clicked => { root.zoom-step(1); }
                }
            }
        }
    }
}
